<!doctype html>
<html lang="en" data-game="@GAME_ID@">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>@TITLE@</title>
<link rel="icon" href="@PROGRAM@.png">
<style>
  /* Each game's colours: th06 scarlet, th07 cherry blossom, th01 violet. */
  :root {
    --ink: #4b2530; --soft: #9a6b76; --red: #d6202c; --red-deep: #a3121e;
    --pink: #ffd6de; --blush: #fff1f4; --card: #ffffff;
    --dot: #ffe3ea; --dash: #ffb3c1; --stripe: #ff6f86; --glow: rgba(214, 32, 44, 0.45);
    --sky: #fff6f8, #ffe2ea 55%, #f6dcf2;
    --font: ui-rounded, "Hiragino Maru Gothic ProN", "M PLUS Rounded 1c", "Nunito", system-ui, sans-serif;
  }
  :root[data-game="th07"] {
    --ink: #4d2840; --soft: #a06a8a; --red: #d9468a; --red-deep: #a32d63;
    --pink: #ffd3e7; --blush: #fff0f7;
    --dot: #fde3f1; --dash: #f5b0d2; --stripe: #f584b9; --glow: rgba(217, 70, 138, 0.4);
    --sky: #fff7fb, #ffe3f0 55%, #e7e1ff;
  }
  :root[data-game="th01"] {
    --ink: #33284d; --soft: #7a6c9e; --red: #6847c4; --red-deep: #46288f;
    --pink: #e1d8ff; --blush: #f5f1ff;
    --dot: #ebe5ff; --dash: #c4b5f5; --stripe: #9a80e6; --glow: rgba(104, 71, 196, 0.4);
    --sky: #f8f6ff, #e8e2ff 55%, #dde8ff;
  }
  html, body { margin: 0; height: 100%; }
  body {
    color: var(--ink); font: 16px/1.5 var(--font);
    background:
      radial-gradient(circle at 12% 18%, #ffffff 0 2px, transparent 3px) 0 0 / 46px 46px,
      radial-gradient(circle at 70% 60%, var(--dot) 0 3px, transparent 4px) 0 0 / 62px 62px,
      linear-gradient(160deg, var(--sky)) fixed;
  }
  #setup {
    position: relative; display: flex; align-items: center; justify-content: center;
    min-height: 100%; padding: 16px 16px 64px; box-sizing: border-box;
  }
  .keys {
    display: flex; flex-wrap: wrap; justify-content: center; gap: 4px 9px;
    margin: 18px 0 0; padding-top: 14px; border-top: 1.5px dashed var(--pink);
    font-size: 0.75em; color: var(--soft); white-space: nowrap;
  }
  .keys kbd {
    display: inline-block; min-width: 1.4em; padding: 1px 5px; margin-right: 3px; border-radius: 6px;
    font: 700 1em var(--font); color: var(--ink); background: var(--blush); box-shadow: 0 2px 0 var(--pink);
  }
  footer {
    position: absolute; left: 16px; right: 16px; bottom: 16px; text-align: center;
    font-size: 0.8em; color: var(--soft);
  }
  footer a { font-weight: 700; }
  .card {
    width: 100%; max-width: 480px; box-sizing: border-box; padding: 28px 28px 22px;
    background: var(--card); border-radius: 28px; text-align: center;
    box-shadow: 0 18px 40px -18px var(--glow), 0 0 0 6px rgba(255, 255, 255, 0.6);
  }
  /* One line of fixed height in either language, so switching does not
     move the card. */
  h1 {
    display: grid; place-items: center; height: 1.6em; margin: 4px 0 0;
    font-size: 2.1em; line-height: 1; letter-spacing: 0.08em; color: var(--red); white-space: nowrap;
  }
  .tagline { margin: 0 0 18px; color: var(--soft); font-size: 0.95em; }
  .sprite {
    width: 68px; height: 84px; image-rendering: pixelated;
    background: url(@RUNNER@) 0 0 / 272px 84px;
    animation: run 0.48s steps(4) infinite;
  }
  @keyframes run { to { background-position: -272px 0; } }
  .art { display: block; width: 112px; height: 112px; margin: -4px auto 0; filter: drop-shadow(0 8px 12px var(--glow)); }
  /* Views share one grid cell, so the card keeps the height of the tallest
     and switching only fades. */
  .stack { display: grid; }
  .stack > * { grid-area: 1 / 1; transition: opacity 0.3s ease, visibility 0.3s; }
  .stack > .off, .fade.off { opacity: 0; visibility: hidden; pointer-events: none; }
  .stack > .center { align-self: center; }
  .fade { transition: opacity 0.35s ease, visibility 0.35s; }
  .segmented {
    display: inline-flex; padding: 4px; gap: 4px; border-radius: 999px; background: var(--blush);
  }
  .segmented label {
    position: relative; padding: 6px 18px; border-radius: 999px; cursor: pointer;
    color: var(--soft); font-weight: 600; transition: background 0.15s, color 0.15s;
  }
  .segmented input { position: absolute; opacity: 0; pointer-events: none; }
  .segmented label:has(input:checked) { background: var(--red); color: #fff; box-shadow: 0 4px 10px -4px var(--red); }
  .segmented label:has(input:focus-visible) { outline: 2px solid var(--red-deep); outline-offset: 2px; }
  .credit { margin: 6px 0 18px; font-size: 0.8em; color: var(--soft); }
  #drop {
    border: 2.5px dashed var(--dash); border-radius: 22px; padding: 22px 18px;
    background: var(--blush);
    transition: opacity 0.3s ease, visibility 0.3s, background 0.15s, border-color 0.15s, transform 0.15s;
  }
  #drop.over { border-color: var(--red); background: var(--pink); transform: scale(1.02); }
  #drop p { margin: 6px 0; }
  /* Two lines in every language, so switching it does not move the card. */
  #drop p[data-text="drop"], #drop p[data-text="dropHdi"] { min-height: 3em; display: grid; place-items: center; text-wrap: balance; }
  .tagline { min-height: 1.5em; text-wrap: balance; }
  #drop small, .hint { color: var(--soft); }
  .data-pickers { display: flex; justify-content: center; gap: 14px; margin: 12px 0 18px; }
  .data-pickers .button { display: flex; align-items: center; justify-content: center; flex: 1; padding: 10px 12px; }
  #file, #folder { position: absolute; width: 1px; height: 1px; opacity: 0; }
  .button, button {
    display: inline-block; font: 700 1em var(--font); border: 0; cursor: pointer;
    padding: 10px 26px; border-radius: 999px; color: #fff; background: var(--red);
    box-shadow: 0 6px 0 var(--red-deep); transition: transform 0.08s, box-shadow 0.08s;
  }
  .button:hover, button:hover { filter: brightness(1.06); }
  .button:active, button:active { transform: translateY(4px); box-shadow: 0 2px 0 var(--red-deep); }
  #play { font-size: 1.25em; padding: 12px 44px; }
  #remembered p { margin: 8px 0; }
  a { color: var(--red); }
  #loading p { margin: 0 0 6px; font-weight: 600; }
  #track { position: relative; height: 14px; margin: 88px 6px 10px; border-radius: 999px; background: var(--pink); }
  #fill {
    position: absolute; inset: 0 auto 0 0; width: 0; border-radius: inherit;
    background: repeating-linear-gradient(-45deg, var(--stripe) 0 10px, var(--red) 10px 20px);
    background-size: 28px 28px; animation: stripes 0.8s linear infinite; transition: width 0.25s linear;
  }
  @keyframes stripes { to { background-position: 28px 0; } }
  #runner { position: absolute; bottom: 10px; left: 0; transform: translateX(-50%); transition: left 0.25s linear; }
  #stage { display: flex; position: fixed; inset: 0; align-items: center; justify-content: center; background: #000; }
  #canvas { display: block; aspect-ratio: @ASPECT@; width: min(100vw, calc(100vh * @ASPECT@)) !important; height: auto !important; outline: none; }
  #controls { position: fixed; right: 12px; bottom: 12px; display: flex; gap: 8px; opacity: 0.35; transition: opacity 0.2s; }
  #controls:hover, #controls:focus-within { opacity: 1; }
  #controls button { padding: 6px 16px; font-size: 0.85em; }
  #log {
    position: fixed; left: 12px; right: 12px; bottom: 12px; max-height: 50%; overflow: auto;
    padding: 14px; border-radius: 18px; background: #fff; color: var(--ink);
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.4); font: 13px/1.4 ui-monospace, monospace;
  }
  #log pre { margin: 0; font: inherit; white-space: pre-wrap; }
  #log button { font-size: 14px; }
  @media (prefers-reduced-motion: reduce) {
    .sprite, #fill { animation: none !important; }
    #fill, #runner { transition: none !important; }
    .stack > *, .fade { transition: none; }
  }
  [hidden] { display: none !important; }
</style>
</head>
<body>
<div id="setup" class="fade off">
  <main class="card">
    <img class="art" src="@PROGRAM@.png" alt="">
    <h1 data-text="heading"></h1>
    <p class="tagline" data-text="tagline"></p>
    <div class="stack">
      <div id="choose">
        <div class="segmented" role="radiogroup" aria-label="Language">
          <label><input type="radio" name="language" value="en"> English</label>
          <label><input type="radio" name="language" value="ja"> <span lang="ja">日本語</span></label>
        </div>
        <p class="credit" id="credit"><span data-text="credit"></span><a href="https://www.thpatch.net">Touhou Patch Center</a></p>
        <div class="stack">
          <div id="remembered" class="center off">
            <p><button id="play" data-text="play"></button></p>
            <p><a href="#" id="forget" data-text="forget"></a></p>
          </div>
          <div id="drop" class="off">
            <p data-text="drop"></p>
            <div class="data-pickers">
              <label class="button" for="file" data-text="choose"></label><input id="file" type="file" accept=".zip,application/zip">
              <label class="button" for="folder" data-text="folder"></label><input id="folder" type="file" webkitdirectory multiple>
            </div>
            <p><small data-text="private"></small></p>
          </div>
        </div>
      </div>
      <div id="loading" class="center off">
        <div id="track">
          <div id="fill"></div>
          <div id="runner"><div class="sprite"></div></div>
        </div>
        <p id="status"></p>
      </div>
    </div>
    <p class="keys" id="keys"></p>
  </main>
  <footer><a href="https://opentouhou.org">opentouhou</a> · <span data-text="footer"></span></footer>
</div>
<div id="stage" class="fade off">
  <canvas id="canvas" tabindex="0" oncontextmenu="event.preventDefault()"></canvas>
  <div id="controls" class="fade off">
    <button id="exit" data-text="exit"></button>
    <button id="fullscreen" data-text="fullscreen"></button>
  </div>
</div>
<div id="log" class="fade off">
  <p><strong data-text="error"></strong></p>
  <pre id="log-text"></pre>
  <p><span id="fallback" hidden><button id="japanese" data-text="japanese"></button> </span><button id="back" data-text="back"></button></p>
</div>
<script>
// Keeps its names local, because the game's script declares globals.
(() => {
  'use strict';
  const PROGRAM = '@PROGRAM@';
  const GAME_ID = '@GAME_ID@';
  // The English patch: the first repository of its network, and the patch.
  const ENGLISH = { repo: 'https://srv.thpatch.net/repo.js', patch: 'thpatch/lang_en' };
  // Whether the English patch covers this game; else English is the page's
  // language only.
  const ENGLISH_PATCH = @ENGLISH_PATCH@;
  @GAME_DATA@
  // SDL keeps the user folder and the patches folder here. Only the user
  // folder is kept in IndexedDB through IDBFS: the patches are written at
  // each start, from their own cache.
  const USER_DIR = '/libsdl/opentouhou/' + GAME_ID;
  const PATCHES_DIR = '/libsdl/opentouhou/patches';
  const LANGUAGE_KEY = 'opentouhou-language';
  const SYNC_MS = 2000;
  const DAY_MS = 24 * 60 * 60 * 1000;
  const FETCH_JOBS = 6;
  // Matches the .fade transition.
  const FADE_MS = 350;
  // SDL's audio runs on the main thread here, so its default buffer of
  // about 20 ms breaks up at every slow frame. ?audio_frames=N overrides it.
  const AUDIO_FRAMES =
    new URLSearchParams(location.search).get('audio_frames') || '2048';
  // ?loader=demo plays the progress bar's steps with made-up sizes, for
  // working on the page without a game.
  const LOADER_DEMO = new URLSearchParams(location.search).get('loader') === 'demo';

  const TITLE = '@TITLE@';
  const TITLE_EN = '@TITLE_EN@';
  const SUBTITLE_EN = '@SUBTITLE_EN@';
  const TEXTS = {
    en: {
      page: TITLE_EN + ': ' + SUBTITLE_EN + ', in your browser',
      heading: TITLE_EN,
      tagline: SUBTITLE_EN,
      credit: 'English by the ',
      play: 'Play',
      forget: 'Forget the game data',
      drop: 'Drop your game ZIP here, or choose a folder:',
      choose: 'Choose ZIP',
      folder: 'Choose folder',
      dropHdi: 'Drop your game ZIP or HDI here, or choose a folder:',
      chooseHdi: 'Choose ZIP or HDI',
      private: 'Your game data stays in this browser.',
      read: 'Reading the game data',
      download: 'Downloading the game',
      check: 'Checking the English patch',
      patch: 'Downloading the English patch',
      start: 'Starting the game',
      fullscreen: 'Fullscreen',
      exit: 'Exit',
      error: 'Something went wrong.',
      webgl: 'The game draws with WebGL 2, which this browser has turned off or lacks. Turn on hardware acceleration (or WebGL) in the browser\'s settings, then reload the page.',
      japanese: 'Play in Japanese',
      back: 'Back',
      footer: 'an unofficial port, not endorsed by ZUN · Touhou Project by ZUN (Team Shanghai Alice)',
    },
    ja: {
      page: TITLE + '：ブラウザで遊ぶ',
      heading: TITLE,
      tagline: 'ブラウザで遊ぶ',
      credit: '英語版：',
      play: 'プレイ',
      forget: 'ゲームデータを消す',
      drop: 'ゲームのzipをここにドロップ、またはフォルダを選択：',
      choose: 'zipを選ぶ',
      folder: 'フォルダを選ぶ',
      dropHdi: 'ゲームのzipかHDIをここにドロップ、またはフォルダを選択：',
      chooseHdi: 'zipかHDIを選ぶ',
      private: 'ゲームデータはこのブラウザの外に出ません。',
      read: 'ゲームデータを読み込み中',
      download: 'ゲームをダウンロード中',
      check: '英語パッチを確認中',
      patch: '英語パッチをダウンロード中',
      start: 'ゲームを起動中',
      fullscreen: '全画面',
      exit: '終了',
      error: 'エラーが発生しました。',
      webgl: 'ゲームの描画にはWebGL 2が必要ですが、このブラウザでは無効か未対応です。ブラウザの設定でハードウェアアクセラレーション（またはWebGL）を有効にしてから、ページを再読み込みしてください。',
      japanese: '日本語で遊ぶ',
      back: '戻る',
      footer: 'ZUNの公認を受けていない非公式の移植 · 東方Project：ZUN（上海アリス幻樂団）',
    },
  };
  // The keys of each kind of game, as its readme lists them.
  const KEYS = {
    stg: [['←↑↓→', 'move', '移動'], ['Z', 'shoot', 'ショット'], ['X', 'bomb', 'ボム'],
      ['Shift', 'focus', '低速'], ['Esc', 'pause', 'ポーズ']],
    th01: [['← →', 'move', '移動'], ['Z', 'shoot', 'ショット'], ['X', 'gohei', 'お祓い棒'],
      ['Z Z X X', 'bomb', 'ボム'], ['Esc', 'pause', 'ポーズ']],
  }['@CONTROLS@'];
  let texts = TEXTS.en;
  // Whether the user folder is mounted, so that leaving saves it.
  let userMounted = false;
  let statusKey = null;
  // Each step of a start takes a share of the one progress bar: English
  // adds the patch's steps. The bar only moves forward.
  const STEPS = {
    en: { download: [0, 0.6], check: [0.6, 0.65], patch: [0.65, 0.85], read: [0.85, 0.95], start: [0.95, 1] },
    ja: { download: [0, 0.85], read: [0.85, 0.95], start: [0.95, 1] },
  };
  let steps = STEPS.ja;
  let progress = 0;

  const $ = (id) => document.getElementById(id);
  const logLines = [];

  // Fades an element in or out.
  function show(element, visible) {
    element.classList.toggle('off', !visible);
  }

  // Switches every text of the page, its title included.
  function applyLanguage(language) {
    texts = TEXTS[language];
    document.documentElement.lang = language;
    document.title = texts.page;
    for (const element of document.querySelectorAll('[data-text]')) {
      element.textContent = texts[element.dataset.text];
    }
    if (statusKey) {
      $('status').textContent = texts[statusKey];
    }
    $('keys').replaceChildren(...KEYS.map(([key, en, ja]) => {
      const item = document.createElement('span');
      const kbd = document.createElement('kbd');
      kbd.textContent = key;
      item.append(kbd, language === 'ja' ? ja : en);
      return item;
    }));
  }

  // Shows text and the log. With retry, also offers to play in Japanese.
  function showError(text, retry) {
    $('log-text').textContent = text + '\n\n' + logLines.join('\n');
    $('fallback').hidden = !retry;
    $('japanese').onclick = () => {
      show($('log'), false);
      retry();
    };
    show($('log'), true);
  }

  function setStatus(key, done, total) {
    show($('choose'), false);
    show($('loading'), true);
    statusKey = key;
    $('status').textContent = texts[key];
    // Reimu runs along the bar; a step of unknown size starts at its share.
    const [from, to] = steps[key];
    progress = Math.max(progress, from + (to - from) * (total ? Math.min(done / total, 1) : 0));
    $('fill').style.width = $('runner').style.left = progress * 100 + '%';
  }


  // Store data holds the selected files, store patches the patch cache.
  let database = null;
  function openStore() {
    database ??= new Promise((resolve, reject) => {
      const request = indexedDB.open('opentouhou-web', 2);
      request.onupgradeneeded = () => {
        for (const name of ['data', 'patches']) {
          if (!request.result.objectStoreNames.contains(name)) {
            request.result.createObjectStore(name);
          }
        }
      };
      request.onsuccess = () => resolve(request.result);
      request.onerror = () => reject(request.error);
    });
    return database;
  }

  async function storeRequest(mode, action, name = 'data') {
    const db = await openStore();
    return new Promise((resolve, reject) => {
      const request = action(db.transaction(name, mode).objectStore(name));
      request.onsuccess = () => resolve(request.result);
      request.onerror = () => reject(request.error);
    });
  }

  function cacheGet(key) {
    return storeRequest('readonly', (store) => store.get(key), 'patches')
      .catch(() => undefined);
  }

  function cachePut(key, value) {
    return storeRequest('readwrite', (store) => store.put(value, key), 'patches')
      .catch((error) => console.error('Cannot cache', key, error));
  }

  // total only drives the bar: the buffer grows when the body is larger.
  async function readWithProgress(stream, total, key, report) {
    let bytes = new Uint8Array(total || 1 << 20);
    const reader = stream.getReader();
    let done = 0;
    for (;;) {
      const chunk = await reader.read();
      if (chunk.done) {
        return bytes.subarray(0, done);
      }
      if (done + chunk.value.length > bytes.length) {
        const grown = new Uint8Array(Math.max(bytes.length * 2, done + chunk.value.length));
        grown.set(bytes.subarray(0, done));
        bytes = grown;
      }
      bytes.set(chunk.value, done);
      done += chunk.value.length;
      if (report) {
        report(Math.min(done, total));
      } else {
        setStatus(key, Math.min(done, total), total);
      }
    }
  }

  async function fetchWasm() {
    const response = await fetch(PROGRAM + '.wasm');
    if (!response.ok) {
      throw new Error('Cannot download ' + PROGRAM + '.wasm: ' + response.status);
    }
    // A compressed response's Content-Length is not the size of the body
    // that fetch() gives; the server can name that size in a meta tag.
    const meta = document.querySelector('meta[name="opentouhou-wasm-size"]');
    const total = response.headers.get('Content-Encoding')
      ? Number(meta?.content) || 0
      : Number(response.headers.get('Content-Length')) || 0;
    return readWithProgress(response.body, total, 'download');
  }

  function readLanguage() {
    try {
      const stored = localStorage.getItem(LANGUAGE_KEY);
      if (stored === 'en' || stored === 'ja') {
        return stored;
      }
    } catch {
      // The browser keeps no storage for this page.
    }
    return navigator.language.startsWith('ja') ? 'ja' : 'en';
  }

  function chosenLanguage() {
    const checked = document.querySelector('input[name="language"]:checked');
    return checked ? checked.value : 'ja';
  }

  const CRC_TABLE = (() => {
    const table = new Uint32Array(256);
    for (let n = 0; n < 256; n++) {
      let c = n;
      for (let k = 0; k < 8; k++) {
        c = c & 1 ? 0xedb88320 ^ (c >>> 1) : c >>> 1;
      }
      table[n] = c;
    }
    return table;
  })();

  function crc32(bytes) {
    let c = 0xffffffff;
    for (const byte of bytes) {
      c = CRC_TABLE[(c ^ byte) & 0xff] ^ (c >>> 8);
    }
    return (c ^ 0xffffffff) >>> 0;
  }

  // Returns the text at url from the cache when it was checked less than a
  // day ago, else from the network, else from the cache at any age.
  async function fetchText(url) {
    const key = 'text:' + url;
    const cached = await cacheGet(key);
    if (cached && Date.now() - cached.time < DAY_MS) {
      return cached.text;
    }
    try {
      const response = await fetch(url, { cache: 'no-cache' });
      if (!response.ok) {
        throw new Error(url + ': ' + response.status);
      }
      const text = await response.text();
      JSON.parse(text);
      await cachePut(key, { time: Date.now(), text });
      return text;
    } catch (error) {
      if (cached) {
        return cached.text;
      }
      throw error;
    }
  }

  // Returns the text of file from the first of servers that gives it.
  async function fetchFrom(servers, file) {
    let failure = null;
    for (const server of servers) {
      try {
        return await fetchText(server + file);
      } catch (error) {
        failure = error;
      }
    }
    throw failure ?? new Error('No server for ' + file);
  }

  // Tells whether a repository id or a patch name is a safe folder name.
  function isSafeName(name) {
    return typeof name === 'string' && name !== '' && name !== '.' && name !== '..'
      && !/[\x00-\x1f/\\:*?"<>|]/.test(name);
  }

  function withSlash(url) {
    return url.endsWith('/') ? url : url + '/';
  }

  // Walks a network of thcrap repositories breadth-first from url, as far as
  // a lookup needs, as core/patch/manager.h describes.
  function openNetwork(url) {
    const repos = [];
    const queue = [url];
    const seen = new Set();
    async function walk() {
      while (queue.length) {
        const at = queue.shift();
        const base = at.endsWith('repo.js') ? at.slice(0, -'repo.js'.length) : withSlash(at);
        if (seen.has(base)) {
          continue;
        }
        seen.add(base);
        let text;
        let json;
        try {
          text = await fetchText(base + 'repo.js');
          json = JSON.parse(text);
        } catch (error) {
          console.warn('Skipping the repository', base, error);
          continue;
        }
        const patches = json?.patches && typeof json.patches === 'object' ? json.patches : {};
        if (!isSafeName(json?.id) || repos.some((repo) => repo.id === json.id)
          || !Object.keys(patches).every(isSafeName)) {
          continue;
        }
        const servers = [base];
        for (const server of Array.isArray(json.servers) ? json.servers : []) {
          if (typeof server === 'string' && !servers.includes(withSlash(server))) {
            servers.push(withSlash(server));
          }
        }
        for (const neighbor of Array.isArray(json.neighbors) ? json.neighbors : []) {
          if (typeof neighbor === 'string') {
            queue.push(neighbor);
          }
        }
        repos.push({ id: json.id, text, servers, patches });
        return true;
      }
      return false;
    }
    return async (test) => {
      for (let i = 0; ; i++) {
        if (i === repos.length && !(await walk())) {
          if (!repos.length) {
            throw new Error('Cannot download ' + url);
          }
          return null;
        }
        if (test(repos[i])) {
          return repos[i];
        }
      }
    };
  }

  // Adds the patch id to list after its dependencies, as PatchRepo_AddPatch
  // of core/patch/repo.h does. A bare name prefers the repository preferred.
  async function addPatch(find, id, preferred, list, adding) {
    const slash = id.indexOf('/');
    const name = id.slice(slash + 1);
    const has = (repo) => Object.hasOwn(repo.patches, name);
    let repo;
    if (slash >= 0) {
      repo = await find((candidate) => candidate.id === id.slice(0, slash));
    } else {
      repo = preferred && has(preferred) ? preferred : await find(has);
    }
    if (!repo || !isSafeName(name)) {
      throw new Error('No repository has the patch ' + id);
    }
    const full = repo.id + '/' + name;
    if (adding.has(full) || list.some((patch) => patch.id === full)) {
      return;
    }
    adding.add(full);
    const text = await fetchFrom(repo.servers.map((server) => server + name + '/'), 'patch.js');
    const json = JSON.parse(text);
    for (const dependency of Array.isArray(json.dependencies) ? json.dependencies : []) {
      if (typeof dependency === 'string') {
        await addPatch(find, dependency, repo, list, adding);
      }
    }
    adding.delete(full);
    const servers = [];
    for (const server of [
      ...(Array.isArray(json.servers) ? json.servers : []),
      ...repo.servers.map((server) => server + name + '/')]) {
      if (typeof server === 'string' && !servers.includes(withSlash(server))) {
        servers.push(withSlash(server));
      }
    }
    list.push({ id: full, repo, name, text, servers });
  }

  // Returns a file of a patch with its CRC-32 from the cache, or else from
  // the first server that gives it, and caches it under its URL and CRC-32.
  async function fetchFile(patch, path, crc) {
    const hex = crc.toString(16).padStart(8, '0');
    const url = patch.servers[0] + path;
    const key = 'file:' + url + '#' + hex;
    const cached = await cacheGet(key);
    if (cached) {
      return { data: cached, fetched: 0 };
    }
    const encoded = path.split('/').map(encodeURIComponent).join('/');
    for (const server of patch.servers) {
      try {
        const response = await fetch(server + encoded + '?crc32=' + hex);
        if (!response.ok) {
          continue;
        }
        const data = new Uint8Array(await response.arrayBuffer());
        if (crc32(data) !== crc) {
          continue;
        }
        await storeRequest('readwrite', (store) => {
          store.delete(IDBKeyRange.bound('file:' + url + '#', 'file:' + url + '#￿'));
          return store.put(data, key);
        }, 'patches').catch((error) => console.error('Cannot cache', key, error));
        return { data, fetched: data.length };
      } catch (error) {
        console.warn('Cannot download', server + path, error);
      }
    }
    throw new Error('Cannot download ' + patch.id + '/' + path);
  }

  // Returns the files of the English patch and its dependencies that this
  // game needs, as paths below the patches folder in the layout of
  // core/patch/stack.h, with their data.
  async function fetchEnglish() {
    setStatus('check');
    const list = [];
    await addPatch(openNetwork(ENGLISH.repo), ENGLISH.patch, null, list, new Set());
    const files = [];
    const jobs = [];
    const encoder = new TextEncoder();
    const repos = new Set();
    for (const patch of list) {
      const dir = patch.repo.id + '/' + patch.name + '/';
      const text = await fetchFrom(patch.servers, 'files.js');
      for (const [path, crc] of Object.entries(JSON.parse(text))) {
        if (typeof crc !== 'number' || path === 'patch.js' || path === 'files.js'
          || (path.includes('/') && !path.startsWith(GAME_ID + '/'))) {
          continue;
        }
        if (path.startsWith('/') || path.split('/').some((part) => part === '' || part === '..')) {
          console.warn('Skipping the file', dir + path);
          continue;
        }
        jobs.push({ patch, path: dir + path, name: path, crc: crc >>> 0 });
      }
      if (!repos.has(patch.repo)) {
        repos.add(patch.repo);
        files.push({ path: patch.repo.id + '/repo.js', data: encoder.encode(patch.repo.text) });
      }
      files.push({ path: dir + 'patch.js', data: encoder.encode(patch.text) });
      files.push({ path: dir + 'files.js', data: encoder.encode(text) });
    }
    let next = 0;
    let done = 0;
    let fetched = 0;
    const worker = async () => {
      while (next < jobs.length) {
        const job = jobs[next++];
        const file = await fetchFile(job.patch, job.name, job.crc);
        files.push({ path: job.path, data: file.data });
        fetched += file.fetched;
        done++;
        setStatus('patch', done, jobs.length);
      }
    };
    await Promise.all(Array.from({ length: FETCH_JOBS }, worker));
    console.log('English patch:', list.map((patch) => patch.id).join(', '), '-',
      jobs.length, 'files,', fetched, 'bytes downloaded');
    return files;
  }

  // Sets [patches] language in config.ini and keeps the other lines.
  function writeLanguage(FS, code) {
    const path = USER_DIR + '/config.ini';
    let text = '';
    try {
      text = FS.readFile(path, { encoding: 'utf8' });
    } catch {
      // The game has not written config.ini yet.
    }
    const lines = text ? text.split('\n') : [];
    const entry = 'language = ' + code;
    // Names compare without case, as core/ini does.
    const header = lines.findIndex((line) => /^\s*\[\s*patches\s*\]\s*$/i.test(line));
    if (header < 0) {
      // At the end, so that keys before the first section stay outside it.
      while (lines.length && !lines[lines.length - 1].trim()) {
        lines.pop();
      }
      lines.push(...(lines.length ? [''] : []), '[patches]', entry, '');
    } else {
      let i = header + 1;
      while (i < lines.length && !lines[i].trim().startsWith('[')
        && !/^\s*language\s*=/i.test(lines[i])) {
        i++;
      }
      if (i < lines.length && !lines[i].trim().startsWith('[')) {
        lines[i] = entry;
      } else {
        lines.splice(header + 1, 0, entry);
      }
    }
    FS.writeFile(path, lines.join('\n'));
  }

  // Saves the user folder a last time, fades the game out and reloads the
  // page, which starts over at Play: a finished game cannot run again.
  function leaveGame() {
    Module.FS.syncfs(false, (error) => {
      if (error) {
        console.error('Cannot save the user folder:', error);
      }
      if (document.fullscreenElement) {
        document.exitFullscreen().catch(() => {});
      }
      show($('stage'), false);
      setTimeout(() => location.reload(), FADE_MS);
    });
  }

  function startSync(FS) {
    let busy = false;
    const sync = () => {
      if (busy) {
        return;
      }
      busy = true;
      FS.syncfs(false, (error) => {
        busy = false;
        if (error) {
          console.error('Cannot save the user folder:', error);
        }
      });
    };
    setInterval(sync, SYNC_MS);
    addEventListener('pagehide', sync);
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'hidden') {
        sync();
      }
    });
  }

  async function playLoaderDemo() {
    steps = STEPS[ENGLISH_PATCH && chosenLanguage() === 'en' ? 'en' : 'ja'];
    progress = 0;
    const tick = () => new Promise((resolve) => setTimeout(resolve, 50));
    for (const [key, total] of [['download', 50], ['check', 0], ['patch', 20], ['read', 10], ['start', 0]]) {
      if (!steps[key]) {
        continue;
      }
      setStatus(key, 0, total);
      for (let done = 1; done <= (total || 10); done++) {
        await tick();
        setStatus(key, done, total);
      }
    }
    await new Promise((resolve) => setTimeout(resolve, 800));
    show($('loading'), false);
    show($('choose'), true);
  }

  // Asks on a canvas of its own, as a canvas keeps the first kind of
  // context that it gives out.
  function hasWebGL2() {
    try {
      return document.createElement('canvas').getContext('webgl2') !== null;
    } catch {
      return false;
    }
  }

  async function start(selection, language = chosenLanguage()) {
    if (!hasWebGL2()) {
      showError(texts.webgl);
      return;
    }
    const patched = ENGLISH_PATCH && language === 'en';
    steps = STEPS[patched ? 'en' : 'ja'];
    progress = 0;
    try {
      setStatus('download');
      const wasm = await fetchWasm();
      let patches = [];
      if (patched) {
        try {
          patches = await fetchEnglish();
        } catch (error) {
          showError('Cannot download the English patch: ' + error.message,
            () => start(selection, 'ja'));
          return;
        }
      }
      setStatus('read');
      window.alert = showError;
      // The game calls this once it has quit and saved.
      globalThis.opentouhouQuit = () => {
        if ($('log').classList.contains('off')) {
          leaveGame();
        }
      };
      window.Module = {
        canvas: $('canvas'),
        wasmBinary: wasm,
        print: (text) => { logLines.push(text); console.log(text); },
        printErr: (text) => { logLines.push(text); console.error(text); },
        onAbort: (reason) => showError('The game stopped: ' + reason),
        onRuntimeInitialized: () => runGame(selection, language, patches).catch(
          (error) => showError(String(error))),
      };
      const script = document.createElement('script');
      script.src = PROGRAM + '.js';
      script.onerror = () => showError('Cannot load ' + PROGRAM + '.js');
      document.body.appendChild(script);
    } catch (error) {
      showError(String(error));
    }
  }

  async function runGame(selection, language, patches) {
    const { FS, IDBFS } = Module;
    const dataPath = await GameData.stage(FS, selection,
      (file, report) => readWithProgress(file.stream(), file.size, 'read', report),
      (done, total) => setStatus('read', done, total));
    setStatus('start');
    FS.mkdirTree(USER_DIR);
    FS.mount(IDBFS, {}, USER_DIR);
    userMounted = true;
    await new Promise((resolve) => FS.syncfs(true, (error) => {
      if (error) {
        console.error('Cannot load the user folder:', error);
      }
      resolve();
    }));
    for (const { path, data } of patches) {
      const full = PATCHES_DIR + '/' + path;
      FS.mkdirTree(full.slice(0, full.lastIndexOf('/')));
      FS.writeFile(full, data);
    }
    if (ENGLISH_PATCH) {
      writeLanguage(FS, language);
    }
    startSync(FS);
    // Paint the loading screen before synchronous game initialization.
    await new Promise((resolve) => requestAnimationFrame(() => requestAnimationFrame(resolve)));
    Module.ENV.SDL_AUDIO_DEVICE_SAMPLE_FRAMES = AUDIO_FRAMES;
    Module.callMain(['--data', dataPath]);
    // Exit and Fullscreen only for a game that started, which the site
    // counts; the page's base is the package's folder, so the path is whole.
    const started = $('log').classList.contains('off');
    show($('controls'), started);
    if (started) {
      show($('setup'), false);
      show($('stage'), true);
      $('canvas').focus();
      navigator.sendBeacon?.('/play/' + PROGRAM + '/started');
    }
  }

  async function remember(file) {
    try {
      await storeRequest('readwrite', (store) => store.put(file, GAME_ID));
    } catch (error) {
      console.error('Cannot remember the game data:', error);
    }
  }

  // Play starts the remembered selection or the files just chosen.
  let stored = null;

  function lockIn(file) {
    stored = file;
    show($('drop'), false);
    show($('remembered'), true);
  }

  function choose(selection) {
    remember(selection).then(() => lockIn(selection));
  }

  $('play').addEventListener('click', () => start(stored));
  if (GAME_ID === 'th01') {
    $('file').accept = '.zip,.hdi,application/zip';
    document.querySelector('[data-text="drop"]').dataset.text = 'dropHdi';
    document.querySelector('[data-text="choose"]').dataset.text = 'chooseHdi';
  }
  $('file').addEventListener('change', () => {
    const file = $('file').files[0];
    if (file) {
      try {
        choose(GameData.fromFile(file, GAME_ID));
      } catch (error) {
        showError(error.message);
      }
    }
  });
  $('folder').addEventListener('change', () => {
    if ($('folder').files.length) {
      try {
        choose(GameData.fromFolder($('folder').files));
      } catch (error) {
        showError(error.message);
      }
    }
  });
  const drop = $('drop');
  drop.addEventListener('dragover', (event) => {
    event.preventDefault();
    drop.classList.add('over');
  });
  drop.addEventListener('dragleave', () => drop.classList.remove('over'));
  drop.addEventListener('drop', async (event) => {
    event.preventDefault();
    drop.classList.remove('over');
    const entry = event.dataTransfer.items[0]?.webkitGetAsEntry?.();
    const file = event.dataTransfer.files[0];
    try {
      if (entry?.isDirectory) {
        choose(await GameData.fromDirectory(entry));
      } else if (file) {
        choose(GameData.fromFile(file, GAME_ID));
      }
    } catch (error) {
      showError(error.message);
    }
  });
  // A failed start may leave the game half run, so back starts the page over.
  $('back').addEventListener('click', () => {
    show($('log'), false);
    show($('stage'), false);
    show($('setup'), false);
    const reload = () => setTimeout(() => location.reload(), FADE_MS);
    if (userMounted) {
      Module.FS.syncfs(false, reload);
    } else {
      reload();
    }
  });
  $('canvas').addEventListener('click', () => $('canvas').focus());
  // The game quits as from its menu, saves, and the page takes over.
  $('exit').addEventListener('click', () => Module._Shell_RequestQuit?.());
  $('fullscreen').addEventListener('click', () => {
    $('stage').requestFullscreen();
    $('canvas').focus();
  });
  $('forget').addEventListener('click', async (event) => {
    event.preventDefault();
    await storeRequest('readwrite', (store) => store.delete(GAME_ID));
    stored = null;
    $('file').value = '';
    $('folder').value = '';
    show($('remembered'), false);
    show($('drop'), true);
  });

  const language = readLanguage();
  applyLanguage(language);
  for (const input of document.querySelectorAll('input[name="language"]')) {
    input.checked = input.value === language;
    input.addEventListener('change', () => {
      applyLanguage(input.value);
      try {
        localStorage.setItem(LANGUAGE_KEY, input.value);
      } catch {
        // The choice holds for this visit only.
      }
    });
  }

  // The drop zone shows only when no game data is remembered.
  storeRequest('readonly', (store) => store.get(GAME_ID)).then((file) => {
    if (file) {
      lockIn(file);
    } else {
      show($('drop'), true);
    }
  }).catch((error) => {
    console.error('Cannot open the stored game data:', error);
    show($('drop'), true);
  });
  // Keeps its line without the English patch, so every game's card has one shape.
  $('credit').style.visibility = ENGLISH_PATCH ? '' : 'hidden';
  requestAnimationFrame(() => show($('setup'), true));
  if (LOADER_DEMO) {
    setTimeout(playLoaderDemo, 600);
  }
})();
</script>
</body>
</html>
