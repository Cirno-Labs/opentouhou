#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-only
"""Build, test and package the games on macOS, for arm64 and x86-64.

The dependencies come from tools/mac/build_deps, one root per
architecture under --deps, with a prefix per set as in the Linux images.
The games build against base and media, in build/mac-<arch>/<target>/,
and othpatch against base and othpatch, in
build/mac-<arch>/othpatch/<target>/. The package is a universal application
bundle per game, signed ad hoc, in a zip under build/packages/, with
the othpatch that src/<game>/othpatch.txt names, downloaded as the
release index gives it, or built from the same commit when that
othpatch has no release.
package-othpatch writes the universal executable of othpatch, signed ad
hoc, as its release names it.

The environment variable RELEASES_URL, when set, gives the build option
releases_url, and the default in meson.options applies otherwise.
shared/othpatch_release.py names the release index that packaging
reads.
OPENTOUHOU_WERROR=1 makes every compiler warning an error, as in CI.
"""

import argparse
import os
import plistlib
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from shared.build import SHARED_SUITES, compile_programs, run_tests
from shared.othpatch_release import pinned_othpatch
from shared.versioning import (
    games,
    generate_package_name,
    generate_version,
    othpatch_asset_name,
    product_name,
)

REPO_DIR = Path(__file__).resolve().parents[2]
MAC_DIR = REPO_DIR / "tools/mac"
PACKAGING_DIR = REPO_DIR / "tools/packaging"
PACKAGES_DIR = REPO_DIR / "build/packages"
ARCHS = ["arm64", "x86_64"]
NATIVE_ARCH = "arm64"
DEPLOYMENT_TARGET = "12.0"
PROGRAMS = ["games", "othpatch"]
DEPS_SETS = {"games": "media", "othpatch": "othpatch"}


def build_dir(arch: str, programs: str, target: str) -> Path:
    if programs == "othpatch":
        return REPO_DIR / "build" / f"mac-{arch}" / "othpatch" / target
    return REPO_DIR / "build" / f"mac-{arch}" / target


def environment(deps: Path, arch: str, programs: str) -> dict[str, str]:
    sets = ["base", DEPS_SETS[programs]]
    libdir = ":".join(str(deps / arch / name / "lib/pkgconfig") for name in sets)
    return {
        **os.environ,
        "MACOSX_DEPLOYMENT_TARGET": DEPLOYMENT_TARGET,
        "PKG_CONFIG_LIBDIR": libdir,
    }


def run_deps(deps: Path) -> None:
    for arch in ARCHS:
        subprocess.check_call([MAC_DIR / "build_deps", arch, deps / arch])


def run_build(deps: Path, programs: str, target: str, archs: list[str]) -> None:
    for arch in archs:
        cross_file = None if arch == NATIVE_ARCH else MAC_DIR / f"{arch}.txt"
        compile_programs(
            build_dir(arch, programs, target),
            programs,
            target,
            cross_file,
            environment(deps, arch, programs),
            REPO_DIR,
        )


def run_test(deps: Path, target: str) -> None:
    for programs in PROGRAMS:
        run_build(deps, programs, target, [NATIVE_ARCH])
        # The games' build runs the suites that every build has.
        run_tests(
            build_dir(NATIVE_ARCH, programs, target),
            SHARED_SUITES if programs == "othpatch" else [],
            environment(deps, NATIVE_ARCH, programs),
        )


def write_bundle(game: str, version: str, target: str, bundle: Path) -> None:
    contents = bundle / "Contents"
    (contents / "MacOS").mkdir(parents=True)
    (contents / "Resources").mkdir()
    subprocess.check_call(
        [
            "lipo",
            "-create",
            *(
                str(build_dir(arch, "games", target) / product_name(game))
                for arch in ARCHS
            ),
            "-output",
            str(contents / "MacOS" / product_name(game)),
        ]
    )
    with open(contents / "Info.plist", "wb") as handle:
        plistlib.dump(
            {
                "CFBundleDevelopmentRegion": "en",
                "CFBundleExecutable": product_name(game),
                "CFBundleIconFile": f"{game}.icns",
                "CFBundleIdentifier": f"io.github.cirno-labs.opentouhou.{game}",
                "CFBundleInfoDictionaryVersion": "6.0",
                "CFBundleName": game,
                "CFBundlePackageType": "APPL",
                "CFBundleShortVersionString": version,
                "CFBundleVersion": version,
                "LSMinimumSystemVersion": DEPLOYMENT_TARGET,
                "NSHighResolutionCapable": True,
            },
            handle,
        )
    resources = contents / "Resources"
    shutil.copy2(PACKAGING_DIR / game / "README.txt", resources / "README.txt")
    shutil.copy2(PACKAGING_DIR / game / "icon.icns", resources / f"{game}.icns")
    # An ad-hoc signature lets the bundle run on Apple silicon. Without a
    # developer identity, Gatekeeper still asks before the first start.
    subprocess.check_call(["codesign", "--force", "--deep", "--sign", "-", str(bundle)])


def run_package(deps: Path, target: str) -> None:
    run_build(deps, "games", target, ARCHS)
    PACKAGES_DIR.mkdir(parents=True, exist_ok=True)
    for game in games(REPO_DIR):
        version = generate_version(game, REPO_DIR)
        othpatch = pinned_othpatch(
            game, "mac", lambda: build_othpatch(deps, target), REPO_DIR
        )
        output = PACKAGES_DIR / f"{generate_package_name(game, version, 'mac')}.zip"
        with tempfile.TemporaryDirectory() as tmp:
            contents = Path(tmp) / "package"
            contents.mkdir()
            bundle = contents / f"{product_name(game)}.app"
            write_bundle(game, version, target, bundle)
            shutil.copy2(othpatch, contents / "othpatch")
            output.unlink(missing_ok=True)
            subprocess.check_call(["ditto", "-c", "-k", str(contents), str(output)])
        print(f"Created {output.relative_to(REPO_DIR)}")


def build_othpatch(deps: Path, target: str) -> Path:
    """Build the universal othpatch, signed ad hoc, and return its path."""
    run_build(deps, "othpatch", target, ARCHS)
    output = REPO_DIR / "build" / "mac-othpatch" / target / "othpatch"
    output.parent.mkdir(parents=True, exist_ok=True)
    output.unlink(missing_ok=True)
    subprocess.check_call(
        [
            "lipo",
            "-create",
            *(str(build_dir(arch, "othpatch", target) / "othpatch") for arch in ARCHS),
            "-output",
            str(output),
        ]
    )
    subprocess.check_call(["codesign", "--force", "--sign", "-", str(output)])
    return output


def run_package_othpatch(deps: Path, target: str) -> None:
    executable = build_othpatch(deps, target)
    PACKAGES_DIR.mkdir(parents=True, exist_ok=True)
    version = generate_version("othpatch")
    output = PACKAGES_DIR / othpatch_asset_name(version, "mac")
    shutil.copy2(executable, output)
    print(f"Created {output.relative_to(REPO_DIR)}")


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--deps",
        type=Path,
        default=REPO_DIR / "build/mac-deps",
        help="the prefix root of the dependencies",
    )
    subparsers = parser.add_subparsers(dest="command", required=True)
    subparsers.add_parser("deps")
    for name in ["build", "test", "package", "package-othpatch"]:
        subparser = subparsers.add_parser(name)
        subparser.add_argument(
            "--target", choices=["debug", "release"], default="debug"
        )
    args = parser.parse_args()
    deps = args.deps.resolve()

    if args.command == "deps":
        run_deps(deps)
    elif args.command == "build":
        for programs in PROGRAMS:
            run_build(deps, programs, args.target, ARCHS)
    elif args.command == "test":
        run_test(deps, args.target)
    elif args.command == "package-othpatch":
        run_package_othpatch(deps, args.target)
    else:
        run_package(deps, args.target)


if __name__ == "__main__":
    main()
