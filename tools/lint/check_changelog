#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-only
"""Fail when a changelog breaks its format or changes a released section.

Takes the paths of changelogs, docs/<program>/CHANGELOG.md, and checks
the format that tools/shared/changelog.py describes. Each released
section, "## X.Y.Z (YYYY-MM-DD)", in the changelog of HEAD must stay in
the file, byte for byte. CHANGELOG_AMEND=X.Y.Z lets the section of that
version change; a comma separates more versions.
"""

import os
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from shared.changelog import check, sections

AMEND_ENV = "CHANGELOG_AMEND"


def committed(path: Path) -> str | None:
    """Return the text of a file in HEAD, or None when HEAD has no such
    file."""
    path = path.resolve()
    result = subprocess.run(
        ["git", "show", f"HEAD:./{path.name}"], cwd=path.parent, capture_output=True
    )
    if result.returncode != 0:
        return None
    return result.stdout.decode()


def check_frozen(old: str, new: str, amend: set[str]) -> list[str]:
    """Return an error for each released section of old that new does not
    hold unchanged, unless amend names its version."""
    current = {item.title: item for item in sections(new) if item.date is not None}
    errors = []
    for item in sections(old):
        if item.date is None or item.title in amend:
            continue
        hint = f"Set {AMEND_ENV}={item.title} to change it on purpose."
        if item.title not in current:
            errors.append(f"the released section '{item.heading}' is gone. {hint}")
        elif current[item.title].text() != item.text():
            errors.append(f"the released section '{item.heading}' changed. {hint}")
    return errors


def check_file(path: Path, amend: set[str]) -> list[str]:
    text = path.read_text()
    errors = check(text, path.parent.name)
    old = committed(path)
    if old is not None:
        errors += check_frozen(old, text, amend)
    return [f"{path}: {error}" for error in errors]


def main(argv: list[str]) -> int:
    amend = {
        version.strip()
        for version in os.environ.get(AMEND_ENV, "").split(",")
        if version.strip()
    }
    errors = [error for name in argv[1:] for error in check_file(Path(name), amend)]
    for error in errors:
        sys.stderr.write(f"{error}\n")
    return 1 if errors else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
