# Selects which backend_<platform>.c a module with platform-specific code
# compiles in. Only 'sdl' exists today.
option(
  'platform',
  type: 'combo',
  choices: ['sdl'],
  value: 'sdl',
  description: 'Platform backend for modules such as core/input',
)
option(
  'game_repository',
  type: 'string',
  value: 'Cirno-Labs/opentouhou',
  description: 'GitHub repository (owner/name) whose releases othpatch updates the games from',
)
