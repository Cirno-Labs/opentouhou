#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-only
"""Print the programs whose version is not in the release index yet.

Prints two lines for $GITHUB_OUTPUT: othpatch=<version>, empty when the
index has othpatch <version> already, and games=<games>, the games
whose version the index does not have, separated by spaces. The index
is a file that `tools/release_index fetch` wrote. A version without a
section in the program's changelog is not ready for its release and is
left out: tools/bump writes that section.

--replace also counts a version that the index has when it was
published less than 24 hours ago, so that the workflow publishes it
again. It fails when that leaves nothing to publish.
"""

import argparse
import datetime
import sys
from pathlib import Path

from shared import release_index
from shared.changelog import changelog_path, section
from shared.versioning import REPO_DIR, games, read_version, version_path


def main(argv: list[str] | None = None, repo_dir: Path = REPO_DIR) -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--index", type=Path, required=True)
    parser.add_argument(
        "--replace",
        action="store_true",
        help="also publish again the versions published less than 24 hours ago",
    )
    args = parser.parse_args(argv)
    index = release_index.load(args.index)
    now = datetime.datetime.now(datetime.UTC)
    refused = []

    def unreleased(program: str) -> str | None:
        version = read_version(version_path(program, repo_dir))
        if section(changelog_path(program, repo_dir).read_text(), version) is None:
            sys.stderr.write(f"{program} {version} has no changelog section yet\n")
            return None
        published = release_index.find(index, program, version)
        if published is None:
            return version
        if args.replace:
            error = release_index.replace_error(program, published, now)
            if error is None:
                return version
            refused.append(error)
        return None

    othpatch = unreleased("othpatch")
    names = [game for game in games(repo_dir) if unreleased(game)]
    if args.replace and othpatch is None and not names:
        sys.exit("\n".join(refused) or "No version to publish or replace")
    for error in refused:
        sys.stderr.write(f"{error}\n")
    print(f"othpatch={othpatch or ''}")
    print(f"games={' '.join(names)}")


if __name__ == "__main__":
    main()
