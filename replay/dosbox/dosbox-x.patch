+
+static uint32_t Harness_FromRgb(uint32_t r, uint32_t g, uint32_t b) {
+    if (GFX_bpp >= 24) return (r << GFX_Rshift) | (g << GFX_Gshift) | (b << GFX_Bshift) | GFX_Amask;
+    if (GFX_Bshift == 0) return (r << 16u) | (g << 8u) | b;
+    return (b << 16u) | (g << 8u) | r;
+}
+
+static uint32_t Harness_ToXrgb(uint32_t p) {
+    uint32_t r, g, b;
+    if (GFX_bpp >= 24) { r = p >> GFX_Rshift; g = p >> GFX_Gshift; b = p >> GFX_Bshift; }
+    else if (GFX_Bshift == 0) { r = p >> 16u; g = p >> 8u; b = p; }
+    else { r = p; g = p >> 8u; b = p >> 16u; }
+    return ((r & 0xFFu) << 16u) | ((g & 0xFFu) << 8u) | (b & 0xFFu);
+}
+
+/* Draws a whole frame from the current state, as the raster would, and puts every state that drawing changes back. */
+void Harness_Render(uint32_t *pixels) {
+    const PC98_GDC_state gdc[2] = { pc98_gdc[0], pc98_gdc[1] };
+    const Text_Draw_State text = pc98_text_draw;
+    const Bitu lines_done = vga.draw.lines_done, blocks = vga.draw.blocks;
+    uint32_t xlat[16];
+    memcpy(xlat, vga.dac.xlat32, sizeof(xlat));
+    if (gdc_analog) {
+        for (unsigned int i = 0; i < 16; i++)
+            vga.dac.xlat32[i] = Harness_FromRgb((pc98_pal_analog[3*i+1] & 0xFu) * 17u, (pc98_pal_analog[3*i+0] & 0xFu) * 17u, (pc98_pal_analog[3*i+2] & 0xFu) * 17u);
+    }
+    vga.draw.blocks = 80;
+    for (unsigned int i = 0; i < 2; i++) pc98_gdc[i].begin_frame();
+    pc98_text_draw.begin_frame();
+    for (unsigned int line = 0; line < 400; line++) {
+        vga.draw.lines_done = line;
+        const uint32_t *src = (const uint32_t*)VGA_PC98_Xlat32_Draw_Line(0, line);
+        for (unsigned int x = 0; x < 640; x++) pixels[line * 640 + x] = Harness_ToXrgb(src[x]);
+        for (unsigned int i = 0; i < 2; i++) pc98_gdc[i].next_line();
+        pc98_text_draw.next_line();
+    }
+    memcpy(vga.dac.xlat32, xlat, sizeof(xlat));
+    vga.draw.lines_done = lines_done;
+    vga.draw.blocks = blocks;
+    pc98_text_draw = text;
+    pc98_gdc[0] = gdc[0];
+    pc98_gdc[1] = gdc[1];
+}
