#!/usr/bin/env python3
"""Fail when a program's version file or changelog is out of order.

Each src/<program>/version.txt must hold one version X.Y.Z, and the
program's changelog, docs/<program>/CHANGELOG.md, must have a section
for it. Each game's src/<game>/othpatch.txt must hold the version X.Y.Z
of the othpatch that its packages ship.
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from shared.changelog import changelog_path, section
from shared.versioning import (
    REPO_DIR,
    games,
    othpatch_pin_path,
    programs,
    read_version,
    version_path,
)


def check_program(program: str) -> list[str]:
    try:
        version = read_version(version_path(program))
    except ValueError as error:
        return [str(error)]
    changelog = changelog_path(program)
    if not changelog.exists():
        return [f"{changelog.relative_to(REPO_DIR)} does not exist"]
    text = changelog.read_text()
    if section(text, version) is None and not section(text, "Unreleased"):
        return [
            f"{changelog.relative_to(REPO_DIR)} has no section ## {version}"
            " and no unreleased changes"
        ]
    return []


def check_pin(game: str) -> list[str]:
    try:
        read_version(othpatch_pin_path(game))
    except (OSError, ValueError) as error:
        return [str(error)]
    return []


def main() -> int:
    errors = [error for program in programs() for error in check_program(program)]
    errors += [error for game in games() for error in check_pin(game)]
    for error in errors:
        sys.stderr.write(f"{error}\n")
    return 1 if errors else 0


if __name__ == "__main__":
    sys.exit(main())
