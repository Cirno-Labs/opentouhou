#!/usr/bin/env python3
"""Print a PNG file as a data: URL, for the web page to inline."""

import argparse
import base64
from pathlib import Path


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("png", type=Path)
    args = parser.parse_args()
    print("data:image/png;base64," + base64.b64encode(args.png.read_bytes()).decode())


if __name__ == "__main__":
    main()
