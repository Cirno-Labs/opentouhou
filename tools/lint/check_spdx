#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-only
"""Fail when a source file does not start with the project's SPDX line.

A C file starts with "// SPDX-License-Identifier: GPL-3.0-only". A
script has "# SPDX-License-Identifier: GPL-3.0-only" as its first line,
or as its second line after a "#!" line.
"""

import sys
from pathlib import Path

LICENSE = "SPDX-License-Identifier: GPL-3.0-only"


def has_line(path: Path) -> bool:
    lines = path.read_text(encoding="utf-8").splitlines()[:2]
    if path.suffix in (".c", ".h"):
        return lines[:1] == [f"// {LICENSE}"]
    if lines[:1] and lines[0].startswith("#!"):
        lines = lines[1:]
    return lines[:1] == [f"# {LICENSE}"]


def main() -> None:
    missing = [name for name in sys.argv[1:] if not has_line(Path(name))]
    for name in missing:
        print(f"{name}: does not start with the line {LICENSE}")
    sys.exit(1 if missing else 0)


if __name__ == "__main__":
    main()
