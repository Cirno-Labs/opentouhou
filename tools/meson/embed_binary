#!/usr/bin/env python3
"""Write a file as a C array: embed_binary OUTPUT NAME INPUT."""

import sys
from pathlib import Path


def main() -> None:
    output = Path(sys.argv[1])
    name = sys.argv[2]
    data = Path(sys.argv[3]).read_bytes()
    rows = [
        ",".join(str(byte) for byte in data[i : i + 32])
        for i in range(0, len(data), 32)
    ]
    output.write_text(
        f"static const uint8_t {name}[] = {{\n" + ",\n".join(rows) + "\n};\n"
    )


if __name__ == "__main__":
    main()
