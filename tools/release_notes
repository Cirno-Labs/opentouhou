#!/usr/bin/env python3
"""Write the description of a GitHub release as Markdown.

The description starts with a table of the downloads: one row per
program, one column per platform, each cell linking to the files of
that program and platform among the files in --packages. The changes
follow: for the release of one program, that version's section of its
changelog; for the development snapshot, each program's unreleased
changes and the commit. The snapshot covers every program with a
changelog and files in --packages.
"""

import argparse
import sys
from pathlib import Path

from shared.changelog import changelog_path, section
from shared.versioning import (
    executable_name,
    games,
    othpatch_pin_path,
    programs,
    read_version,
)

PLATFORMS = ["Linux", "Windows", "macOS"]


def file_prefix(program: str) -> str:
    """Return the start of the names of a program's files, such as
    oth06- or othpatch-."""
    return "othpatch-" if program == "othpatch" else f"{executable_name(program)}-"


def file_suffix(program: str, platform: str) -> str:
    """Return the end of the name of a program's file for a platform, such
    as -Linux.zip or -Windows.exe."""
    if program != "othpatch":
        return f"-{platform}.zip"
    return f"-{platform}.exe" if platform == "Windows" else f"-{platform}"


def downloads_table(names: list[str], files: list[str], url: str) -> str:
    rows = [
        "| Program | " + " | ".join(PLATFORMS) + " |",
        "|---" * (len(PLATFORMS) + 1) + "|",
    ]
    for program in names:
        cells = []
        for platform in PLATFORMS:
            matches = [
                name
                for name in files
                if name.startswith(file_prefix(program))
                and name.endswith(file_suffix(program, platform))
            ]
            cells.append(" ".join(f"[{name}]({url}/{name})" for name in matches) or "–")
        rows.append(f"| {program} | " + " | ".join(cells) + " |")
    return "\n".join(rows)


def unwrap(text: str) -> str:
    """Join the wrapped lines of each list item into one line.

    GitHub shows a line break inside a release description as a break,
    so a wrapped changelog item would show as several short lines.
    """
    lines: list[str] = []
    for line in text.splitlines():
        if line.startswith("  ") and lines and lines[-1].startswith("- "):
            lines[-1] += " " + line.strip()
        else:
            lines.append(line)
    return "\n".join(lines)


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repository", required=True, help="such as rr-/opentouhou")
    parser.add_argument("--tag", required=True, help="such as th06-v1.2.0 or latest")
    parser.add_argument("--packages", type=Path, required=True)
    parser.add_argument("--program", help="the released program, such as th06")
    parser.add_argument("--version", help="the released version, such as 1.2.0")
    parser.add_argument("--commit", help="the commit, for the snapshot")
    args = parser.parse_args()

    files = sorted(path.name for path in args.packages.iterdir() if path.is_file())
    url = f"https://github.com/{args.repository}/releases/download/{args.tag}"
    if args.program is not None:
        body = section(changelog_path(args.program).read_text(), args.version)
        if body is None:
            sys.exit(f"The changelog of {args.program} has no section {args.version}")
        parts = [downloads_table([args.program], files, url)]
        if args.program in games():
            othpatch = read_version(othpatch_pin_path(args.program))
            parts.append(f"The packages include othpatch {othpatch}.")
        parts.append(f"## Changes\n\n{unwrap(body or 'None.')}")
    else:
        names = [
            program
            for program in programs()
            if changelog_path(program).exists()
            and any(name.startswith(file_prefix(program)) for name in files)
        ]
        parts = [downloads_table(names, files, url)]
        for program in names:
            body = section(changelog_path(program).read_text(), "Unreleased")
            parts.append(
                f"## {program}: unreleased changes\n\n{unwrap(body or 'None yet.')}"
            )
        if args.commit is not None:
            parts.append(f"Built from {args.commit} on develop.")
    print("\n\n".join(parts))


if __name__ == "__main__":
    main()
