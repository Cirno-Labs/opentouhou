#!/usr/bin/env python3
"""Capture and replay games under the replay harness (docs/REPLAY.md).

capture runs a game with an input script, or with a person's play, and
writes a new case file. replay runs a case, compares every state row with
the case's, writes the screenshots that --shots selects as PNG files and,
with --against, compares them with an earlier run's. --headless draws
nothing, and --fast draws only the frames just before each screenshot.
--backend dosbox runs a PC-98 original in the patched DOSBox-X of the
opentouhou-dosbox-x image, which `just replay::dosbox-x` builds; outside
that image, the run starts a container of it.
The exit status is 0 when the run matches, 1 when a state row or a
compared screenshot differs and 2 on an error.
rows prints a case's state rows, the changed ones by default, and with a
run's output directory prints the rows where the run differs from the
case.
"""

import argparse
import configparser
import io
import os
import platform
import re
import shutil
import struct
import subprocess
import sys
import tempfile
import zipfile
from pathlib import Path

REPO_DIR = Path(__file__).resolve().parents[1]
BACKENDS = ("native", "retail", "dosbox")
DOSBOX_IMAGE = "opentouhou-dosbox-x"
# Wine runs a game without audio drivers, since a run plays no sound and a
# driver without a device can stall DirectSound, and in a Japanese locale,
# which the file names of the games need.
WINE_ENV = {
    "WINEDLLOVERRIDES": "winealsa.drv,winepulse.drv,wineoss.drv,winecoreaudio.drv=",
    "LANG": "ja_JP.UTF-8",
    "LC_ALL": "ja_JP.UTF-8",
}


def under_wine(args: argparse.Namespace) -> bool:
    return args.backend == "retail" and sys.platform != "win32"


def native_program(game: str) -> tuple[Path, str]:
    """Returns the game's native backend in the debug build of this machine
    and the command that builds it."""
    if sys.platform == "win32":
        program = REPO_DIR / "build" / "win" / "debug" / f"{game}native.exe"
        return program, "just build-win"
    if sys.platform == "darwin":
        program = REPO_DIR / "build" / f"mac-{platform.machine()}" / "debug"
        return program / f"{game}native", "tools/mac/build build --target debug"
    return REPO_DIR / "build" / "linux" / "debug" / f"{game}native", "just build-linux"


def program(args: argparse.Namespace, game: str) -> tuple[Path, str | None]:
    """Returns the backend program and the command that builds it, which a
    --program of its own has none of."""
    if args.program is not None:
        return args.program, None
    if args.backend == "native":
        return native_program(game)
    if args.backend == "dosbox":
        program = REPO_DIR / "build" / "linux" / "debug" / f"{game}dosbox"
        return program, "just build-linux"
    return (
        REPO_DIR / "build" / "retail" / game / f"{game}retail.exe",
        f"just replay::build {game}",
    )


def program_path(args: argparse.Namespace, path: Path) -> str:
    """Returns path as the backend program sees it, such as Z:\\abs."""
    path = path.resolve()
    if not under_wine(args):
        return str(path)
    return subprocess.run(
        ["winepath", "-w", str(path)], check=True, capture_output=True, text=True
    ).stdout.strip()


def in_container(args: argparse.Namespace) -> bool:
    """Returns whether a dosbox run starts a container of its image, which it
    does unless dosbox-x is on PATH."""
    return args.backend == "dosbox" and shutil.which("dosbox-x") is None


def mounts(args: argparse.Namespace, out: Path) -> list[str]:
    """Returns the docker run options of a dosbox run: the directories of
    every path of its command line, each at its own path, read-only but for
    the ones that the run writes."""
    paths = {}

    def add(path: Path | None, writable: bool = False) -> None:
        if path is None:
            return
        path = path.resolve()
        if writable and path == out.resolve():
            path.mkdir(parents=True, exist_ok=True)
        directory = path if path.is_dir() else path.parent
        paths[directory] = paths.get(directory, False) or writable

    add(args.data)
    add(out, True)
    if args.verb == "capture":
        add(args.case, True)
        add(args.script)
        for spec in args.file:
            file = spec.rpartition("=")[0]
            add(Path(file) if file else None)
    else:
        add(args.case)
        add(args.against)
        if args.shots is not None and args.shots.startswith("@"):
            add(Path(args.shots[1:]))
    options = []
    for directory, writable in sorted(paths.items()):
        mode = "" if writable else ":ro"
        options += ["-v", f"{directory}:{directory}{mode}"]
    return options


def start(
    args: argparse.Namespace, game: str, argv: list[str], out: Path | None = None
) -> int:
    path, build = program(args, game)
    if not path.is_file():
        message = f"harness: {path} is missing"
        if build is not None:
            message += f"; build the {args.backend} backend with `{build}`"
        print(message, file=sys.stderr)
        return 2
    command = [str(path.resolve())] + argv
    env = None
    if in_container(args):
        image = os.environ.get("OPENTOUHOU_DOSBOX_IMAGE", DOSBOX_IMAGE)
        program_dir = path.resolve().parent
        command = [
            "docker",
            "run",
            "--rm",
            "--init",
            "--user",
            f"{os.getuid()}:{os.getgid()}",
            "-e",
            "HOME=/tmp",
            "-v",
            f"{program_dir}:{program_dir}:ro",
            *mounts(args, out),
            image,
        ] + command
    if under_wine(args):
        command = ["wine"] + command
        env = os.environ | WINE_ENV
        # The original skips frames while its window is inactive, so it
        # runs on a private X server unless it shows a window.
        if not args.window and shutil.which("xvfb-run") is not None:
            command = ["xvfb-run", "-a", "-s", "-screen 0 1024x768x24"] + command
    return subprocess.run(command, env=env).returncode


def common_argv(args: argparse.Namespace, role: str, out: Path) -> list[str]:
    argv = [
        role,
        program_path(args, args.case),
        "--data",
        program_path(args, args.data),
        "--out",
        program_path(args, out),
    ]
    if args.headless:
        argv.append("--headless")
    return argv


def file_argv(args: argparse.Namespace, spec: str) -> list[str]:
    """Returns --file FILE=PATH with FILE as the backend program sees it."""
    file, _, path = spec.rpartition("=")
    if file:
        spec = f"{program_path(args, Path(file))}={path}"
    return ["--file", spec]


def capture(args: argparse.Namespace) -> int:
    args.case.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="harness-capture-") as out:
        argv = common_argv(args, "capture", Path(out))
        if args.live:
            argv.append("--live")
        if args.script is not None:
            argv += ["--script", program_path(args, args.script)]
        for spec in args.file:
            argv += file_argv(args, spec)
        if args.note is not None:
            argv += ["--note", args.note]
        return start(args, args.game, argv, Path(out))


def read_manifest(case: Path) -> configparser.ConfigParser:
    manifest = configparser.ConfigParser(inline_comment_prefixes=(";", "#"))
    with zipfile.ZipFile(case) as archive:
        manifest.read_string(archive.read("case.ini").decode())
    return manifest


def replay(args: argparse.Namespace) -> int:
    game = read_manifest(args.case)["case"]["game"]
    argv = common_argv(args, "replay", args.out)
    if args.fast:
        argv.append("--fast")
    if args.shots is not None:
        shots = args.shots
        if shots.startswith("@"):
            shots = "@" + program_path(args, Path(shots[1:]))
        argv += ["--shots", shots]
    if args.against is not None:
        argv += ["--against", program_path(args, args.against)]
    return start(args, game, argv, args.out)


# The chunks and checks of state.bin (replay/harness/state.h).
STATE_CHUNK_ROWS = 3600
STATE_CHECK_ROWS = 60


def game_columns(game: str) -> list[tuple[str, str]]:
    """Returns the names and kinds of a game's columns from the CALC_FIELDS
    macro of its replay/GAME/fields.h."""
    text = (REPO_DIR / "replay" / game / "fields.h").read_text()
    start = text.index(f"{game.upper()}_CALC_FIELDS(X)")
    end = text.index("\n\n", start)
    return re.findall(r"X\((\w+), (\w+)\)", text[start:end])


def read_state(data: bytes, columns: list[tuple[str, str]], rows: int) -> list[list]:
    """Returns the rows of state.bin: the frame, then one value per column,
    None for a HASH column on a row without a check."""
    stream = io.BytesIO(data)

    def varint() -> int:
        value = shift = 0
        while True:
            byte = stream.read(1)[0]
            value |= (byte & 0x7F) << shift
            shift += 7
            if not byte & 0x80:
                return value

    stored = [0] + [i + 1 for i, (_, kind) in enumerate(columns) if kind != "HASH"]
    hashes = [i + 1 for i, (_, kind) in enumerate(columns) if kind == "HASH"]
    out: list[list] = []
    while len(out) < rows:
        count = min(rows - len(out), STATE_CHUNK_ROWS)
        chunk: list[list] = [[None] * (1 + len(columns)) for _ in range(count)]
        for column in stored:
            mode = stream.read(1)[0]
            a = b = row = 0
            while row < count:
                end = row + varint()
                value = None if end == count else varint()
                while row < end or (row == end and value is not None):
                    encoded = 0
                    if row == end:
                        encoded = (value >> 1) ^ (-(value & 1) & 0xFFFFFFFF)
                    if mode == 0:
                        current = encoded ^ a
                    elif mode == 1:
                        current = (encoded + a) & 0xFFFFFFFF
                    else:
                        current = (encoded + 2 * a - b) & 0xFFFFFFFF
                    chunk[row][column] = current
                    a, b = current, a
                    row += 1
        stream.read((count + 1) // 2)
        for row in range(count):
            if (row + 1) % STATE_CHECK_ROWS == 0 or row + 1 == count:
                stream.read(4)
                for column in hashes:
                    chunk[row][column] = struct.unpack("<I", stream.read(4))[0]
        out += chunk
    return out


def format_value(kind: str, value: int | None) -> str:
    if value is None:
        return "-"
    if kind == "HASH":
        return f"{value:08x}"
    if kind == "I32" and value >> 31:
        return str(value - (1 << 32))
    return str(value)


def rows(args: argparse.Namespace) -> int:
    manifest = read_manifest(args.case)
    game = manifest["case"]["game"]
    columns = game_columns(game)
    with zipfile.ZipFile(args.case) as archive:
        expected = read_state(
            archive.read("state.bin"), columns, int(manifest["case"]["rows"])
        )
    shown = args.columns.split(",") if args.columns else [name for name, _ in columns]
    unknown = set(shown) - {name for name, _ in columns}
    if unknown:
        print(
            f"harness: {game} has no column {', '.join(sorted(unknown))}",
            file=sys.stderr,
        )
        return 2
    picked = [i + 1 for i, (name, _) in enumerate(columns) if name in shown]

    def line(row: list) -> list[str]:
        return [format_value(columns[i - 1][1], row[i]) for i in picked]

    def in_range(frame: int) -> bool:
        return args.start <= frame and (args.end is None or frame <= args.end)

    names = [columns[i - 1][0] for i in picked]
    if args.run_dir is None:
        print("frame " + " ".join(names))
        previous = None
        for row in expected:
            current = line(row)
            if in_range(row[0]) and (args.all or current != previous):
                print(row[0], " ".join(current))
            previous = current
        return 0
    report = configparser.ConfigParser(inline_comment_prefixes=(";", "#"))
    report.read(args.run_dir / "report.ini")
    actual = read_state(
        (args.run_dir / "state.bin").read_bytes(),
        columns,
        int(report["report"]["rows"]),
    )
    print("frame column case run")
    shown_rows = 0
    for index in range(max(len(expected), len(actual))):
        if index >= len(expected) or index >= len(actual):
            side = "run" if index < len(actual) else "case"
            print(f"row {index}: only the {side} has it")
            return 1
        want, got = expected[index], actual[index]
        if want[0] != got[0]:
            print(f"row {index}: frame {want[0]} in the case, {got[0]} in the run")
            return 1
        if not in_range(want[0]):
            continue
        cells = [
            f"{names[j]} {a} {b}"
            for j, (a, b) in enumerate(zip(line(want), line(got), strict=True))
            if a != b and "-" not in (a, b)
        ]
        if cells:
            print(want[0], "  ".join(cells))
            shown_rows += 1
            if shown_rows == args.limit:
                break
    return 1 if shown_rows else 0


def add_backend(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--backend", choices=BACKENDS, default="native")
    parser.add_argument(
        "--program", type=Path, help="the backend program, if not the build's"
    )
    parser.add_argument("--data", type=Path, required=True, help="the game's directory")
    parser.add_argument(
        "--headless", action="store_true", help="draw nothing, take no screenshots"
    )
    parser.add_argument(
        "--window",
        action="store_true",
        help="show a retail run on the current display",
    )


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    verbs = parser.add_subparsers(dest="verb", required=True)

    capture_parser = verbs.add_parser("capture", help="write a new case")
    capture_parser.add_argument("game", help="the game id, such as th06")
    capture_parser.add_argument("case", type=Path, help="the case file to write")
    add_backend(capture_parser)
    capture_parser.add_argument("--script", type=Path, help="the input script")
    capture_parser.add_argument(
        "--live", action="store_true", help="record a person's play"
    )
    capture_parser.add_argument(
        "--file",
        action="append",
        default=[],
        metavar="FILE=PATH",
        help="stage FILE at PATH among the game's files from frame 0 on",
    )
    capture_parser.add_argument("--note")
    capture_parser.set_defaults(run=capture)

    replay_parser = verbs.add_parser("replay", help="run a case and compare")
    replay_parser.add_argument("case", type=Path, help="the case file")
    add_backend(replay_parser)
    replay_parser.add_argument(
        "--out", type=Path, required=True, help="the output directory"
    )
    replay_parser.add_argument(
        "--shots",
        help="the frames to screenshot, such as 21345, 0,100,every:300 or @FILE",
    )
    replay_parser.add_argument(
        "--fast",
        action="store_true",
        help="draw only the frames just before each screenshot",
    )
    replay_parser.add_argument(
        "--against", type=Path, help="an earlier run's output directory"
    )
    replay_parser.set_defaults(run=replay)

    rows_parser = verbs.add_parser("rows", help="print or compare state rows")
    rows_parser.add_argument("case", type=Path, help="the case file")
    rows_parser.add_argument(
        "run_dir",
        metavar="run",
        type=Path,
        nargs="?",
        help="a replay's output directory to compare",
    )
    rows_parser.add_argument(
        "--columns", help="the columns to print, such as score,lives"
    )
    rows_parser.add_argument(
        "--from", dest="start", type=int, default=0, help="the first frame"
    )
    rows_parser.add_argument("--to", dest="end", type=int, help="the last frame")
    rows_parser.add_argument(
        "--all", action="store_true", help="print every row, not the changed ones"
    )
    rows_parser.add_argument(
        "--limit", type=int, default=20, help="the differing rows to print at most"
    )
    rows_parser.set_defaults(run=rows)

    args = parser.parse_args(argv)
    backend = getattr(args, "backend", None)
    if getattr(args, "window", False) and backend != "retail":
        parser.error("--window shows a retail run only")
    if backend == "dosbox" and getattr(args, "live", False):
        parser.error("the dosbox backend takes no --live")
    return args.run(args)


if __name__ == "__main__":
    sys.exit(main())
