# Build a game's capture tracer (dev only, see docs/BUILDING.md).
[group('replay')]
build game:
    just -f {{justfile_directory()}}/justfile image-win "0"
    just -f {{justfile_directory()}}/justfile _docker_run win replay {{game}}

# Compare a case or directory against its original .rpy inputs.
[group('replay')]
[no-cd]
run cases data replays:
    just -f {{justfile_directory()}}/justfile build-linux
    {{quote(justfile_directory())}}/build/linux/debug/th06replay --data {{quote(data)}} --replays {{quote(replays)}} {{quote(cases)}}
