#!/usr/bin/env python3
"""Render a program's icon into the Windows .ico and the macOS .icns.

The source is <program>/icon.png beside this script, a square image of at
least 1024x1024 pixels with transparency. The icons, icon.ico and
icon.icns, are committed beside it, so builds need no converter. Run
this again after changing the PNG. Needs Pillow.
"""

import argparse
from pathlib import Path

from PIL import Image

PACKAGING_DIR = Path(__file__).resolve().parent
ICO_SIZES = [16, 24, 32, 48, 64, 128, 256]
ICNS_SIZES = [16, 32, 64, 128, 256, 512, 1024]


def render(source: Image.Image, size: int) -> Image.Image:
    return source.resize((size, size), Image.LANCZOS)


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("program", help="such as th06 or othpatch")
    program = parser.parse_args().program
    program_dir = PACKAGING_DIR / program
    source = Image.open(program_dir / "icon.png").convert("RGBA")
    if source.width != source.height or source.width < max(ICNS_SIZES):
        raise SystemExit(f"{program}/icon.png must be square and at least {max(ICNS_SIZES)} pixels wide")
    largest = render(source, max(ICNS_SIZES))
    images = {size: render(source, size) for size in ICO_SIZES}
    images[ICO_SIZES[-1]].save(
        program_dir / "icon.ico",
        sizes=[(size, size) for size in ICO_SIZES],
        append_images=[images[size] for size in ICO_SIZES[:-1]],
    )
    largest.save(program_dir / "icon.icns")
    print(f"Wrote {program}/icon.ico and {program}/icon.icns")


if __name__ == "__main__":
    main()
