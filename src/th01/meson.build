subdir('opna')

th01_lib = static_library(
  'th01_lib',
  'bfnt.c',
  'bos.c',
  'boss_entity.c',
  'boss_render.c',
  'boss_hit.c',
  'boss_defeat.c',
  'boss_b05.c',
  'boss_b10m.c',
  'boss_b10j.c',
  'boss_b15j.c',
  'boss_b15m.c',
  'boss_b20j.c',
  'route_select.c',
  'sprite.c',
  'shape.c',
  'particles.c',
  'wave.c',
  'interleave.c',
  'transition.c',
  'scale2x.c',
  'items.c',
  'hud.c',
  'timer.c',
  'hud_hp.c',
  'extend.c',
  'shots.c',
  'reiiden_image.c',
  'pellet_assets.c',
  'shootout_lasers.c',
  'pellets.c',
  'missiles.c',
  'line_bullets.c',
  'player.c',
  'bomb.c',
  'miss.c',
  'logo.c',
  'opening.c',
  'opening_load.c',
  'frame.c',
  'math.c',
  'finite.c',
  'orb.c',
  'input.c',
  'settings.c',
  'video.c',
  'palette.c',
  'text.c',
  'tram.c',
  'mdrv_data.c',
  'mdrv_seq.c',
  'mdrv_synth.c',
  'opna/opna.c',
  'pf.c',
  'pi.c',
  'ptn.c',
  'grc.c',
  'grf.c',
  'grz.c',
  'stage_data.c',
  'scene.c',
  'stage_objects.c',
  'stage.c',
  'stage_obstacles.c',
  'stage_orb.c',
  c_args: [layer_include['th01']],
  implicit_include_directories: false,
  dependencies: [core_dep, stg_dep, opna_dep],
)

th01_version = custom_target(
  'th01_version',
  output: 'version.h',
  command: [python3, files('../../tools/meson/version_header'), 'th01', '@OUTPUT@'],
  build_always_stale: true,
)

th01_main_lib = static_library(
  'th01_main',
  'main.c',
  th01_version,
  c_args: [layer_include['th01'], layer_include['shell'], '-I' + meson.current_build_dir()],
  implicit_include_directories: false,
  dependencies: [core_dep, stg_dep],
)

th01_sources = [files('entry.c')]
if host_machine.system() == 'windows'
  th01_sources += import('windows').compile_resources(
    'th01.rc',
    args: ['--include-dir', meson.current_build_dir(),
           '--include-dir', meson.project_source_root() / 'tools/packaging/th01'],
    depends: th01_version,
    depend_files: files('../../tools/packaging/th01/icon.ico'),
  )
endif

games += {
  'th01': {
    'sources': th01_sources,
    'c_args': [layer_include['th01']],
    'fonts': ['fonts/ipag.ttf', 'fonts/ipagp.ttf'],
    'link_with': [th01_main_lib, th01_lib],
  },
}
