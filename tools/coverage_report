#!/usr/bin/env python3
"""Report the coverage that a coverage build recorded.

Reads the .gcda files of the build directory with llvm-cov gcov, and
prints, for each source file under the given source directory, the share
of its lines that ran, lowest first, and the functions that never ran.
"""

import argparse
import re
import subprocess
from dataclasses import dataclass, field
from pathlib import Path

FILE = re.compile(r"^File '(.+)'$")
FUNCTION = re.compile(r"^Function '(.+)'$")
LINES = re.compile(r"^Lines executed:([0-9.]+)% of ([0-9]+)$")


@dataclass
class Source:
    percent: float = 0.0
    lines: int = 0
    unrun: list[str] = field(default_factory=list)


def read(build: Path, gcda: Path, sources: dict[str, Source]) -> None:
    """Add the files of one object, and its functions that never ran to
    the file that the object compiles."""
    output = subprocess.run(
        ["llvm-cov", "gcov", "-n", "-f", "-o", str(gcda.parent), str(gcda)],
        cwd=build,
        capture_output=True,
        text=True,
        check=True,
    ).stdout
    unrun = []
    function = name = None
    for line in output.splitlines():
        if match := FUNCTION.match(line):
            function, name = match[1], None
        elif match := FILE.match(line):
            function, name = None, str((build / match[1]).resolve())
        elif match := LINES.match(line):
            if function is not None and float(match[1]) == 0.0:
                unrun.append(function)
            elif name is not None:
                entry = sources.setdefault(name, Source())
                entry.percent = float(match[1])
                entry.lines = int(match[2])
                if Path(name).name == gcda.stem:
                    entry.unrun.extend(unrun)


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("build", type=Path, help="the coverage build directory")
    parser.add_argument("source", type=Path, help="such as src/th01")
    args = parser.parse_args()
    build = args.build.resolve()
    source = args.source.resolve()
    sources: dict[str, Source] = {}
    for gcda in sorted(build.rglob("*.gcda")):
        read(build, gcda, sources)
    shown = {
        name: entry
        for name, entry in sources.items()
        if Path(name).is_relative_to(source) and entry.lines > 0
    }
    for name, entry in sorted(shown.items(), key=lambda item: item[1].percent):
        relative = Path(name).relative_to(source)
        line = f"{entry.percent:6.2f}% of {entry.lines:5}  {relative}"
        if entry.unrun:
            line += "  never: " + " ".join(sorted(set(entry.unrun)))
        print(line)


if __name__ == "__main__":
    main()
