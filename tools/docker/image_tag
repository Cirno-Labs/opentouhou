#!/usr/bin/env python3
"""Print the full image name and tag for a build-image platform."""

import argparse
import datetime
import hashlib
import os
import subprocess
import sys
from pathlib import Path

REPO_DIR = Path(__file__).resolve().parents[2]
DEFAULT_OWNER = "cirno-labs"


def image_prefix() -> str:
    """Return the registry prefix of the images.

    GitHub Actions names the owner of the repository that runs the
    workflow, so a fork builds, pushes and pulls its own images.
    """
    owner = os.environ.get("GITHUB_REPOSITORY_OWNER") or DEFAULT_OWNER
    return f"ghcr.io/{owner.lower()}/opentouhou-"


def dockerfile_hash(dockerfile: Path) -> str:
    digest = hashlib.sha256(dockerfile.read_bytes()).hexdigest()
    return digest[:8]


def dockerfile_date(dockerfile: Path) -> str:
    """Return the date of the last commit that changed the Dockerfile.

    Returns today's date when the Dockerfile has uncommitted changes or no
    commit yet.
    """
    status = subprocess.run(
        ["git", "status", "--porcelain", "--", str(dockerfile)],
        cwd=REPO_DIR,
        capture_output=True,
        text=True,
        check=True,
    )
    if status.stdout.strip():
        return today()
    log = subprocess.run(
        ["git", "log", "-1", "--format=%cd", "--date=format:%Y%m%d", "--", str(dockerfile)],
        cwd=REPO_DIR,
        capture_output=True,
        text=True,
        check=True,
    )
    date = log.stdout.strip()
    return date if date else today()


def today() -> str:
    return datetime.date.today().strftime("%Y%m%d")


def image_tag(platform: str) -> str:
    dockerfile = REPO_DIR / "tools/docker" / platform / "Dockerfile"
    return f"{dockerfile_date(dockerfile)}-{dockerfile_hash(dockerfile)}"


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("platform", choices=["linux", "win"])
    args = parser.parse_args()
    print(f"{image_prefix()}{args.platform}:{image_tag(args.platform)}")


if __name__ == "__main__":
    main()
