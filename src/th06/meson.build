# Everything but main.c and stubs.c, so the replay runner and the tests
# link it too; stubs.c stays out so a test can link its own stand-ins for
# the unported modules instead. The core/app functions that it calls
# come from core/app in the game, from replay/th06/runner/app_null.c in
# the runner and from tests/app_fake.c in the tests.
th06_lib = static_library(
  'th06_lib',
  'angle.c',
  'anm/state.c',
  'anm/draw.c',
  'anm/texture.c',
  'anm/text.c',
  'ascii/chain.c',
  'ascii/pause_menu.c',
  'ascii/text.c',
  'bomb/update.c',
  'bomb/draw.c',
  'bullet.c',
  'buttons.c',
  'chain.c',
  'ecl.c',
  'effect.c',
  'enemy.c',
  'files.c',
  'game.c',
  'game_manager/chain.c',
  'game_manager/state.c',
  'game_manager/camera.c',
  'gui/gui.c',
  'gui/draw.c',
  'item.c',
  'player.c',
  'replay/chain.c',
  'replay/format.c',
  'scene.c',
  'screen_effect.c',
  'screens/main.c',
  'screens/music/comments.c',
  'screens/music/screen.c',
  'screens/result/records.c',
  'screens/result/saves.c',
  'screens/result/score.c',
  'screens/result/screen.c',
  'sound/events.c',
  'settings.c',
  'sound/player.c',
  'stage.c',
  'strings.c',
  'timer.c',
  c_args: [layer_include['th06']],
  implicit_include_directories: false,
  dependencies: [core_dep, stg_dep],
)

games += {
  'th06': {
    'sources': files('main.c', 'stubs.c'),
    'c_args': [layer_include['th06']],
    'link_with': [th06_lib],
  },
}
