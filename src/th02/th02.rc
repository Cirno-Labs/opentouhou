#include <winver.h>
#include "version.h"


VS_VERSION_INFO VERSIONINFO
FILEVERSION GAME_VERSION_RC
PRODUCTVERSION GAME_VERSION_RC
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "opentouhou"
            VALUE "FileDescription", "opentouhou th02: the Story of Eastern Wonderland"
            VALUE "FileVersion", GAME_VERSION
            VALUE "InternalName", "oth02"
            VALUE "OriginalFilename", "oth02.exe"
            VALUE "ProductName", "opentouhou th02"
            VALUE "ProductVersion", GAME_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
