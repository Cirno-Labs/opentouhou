th01_lib = static_library(
  'th01_lib',
  'audio.c',
  'present.c',
  'music.c',
  'bos.c',
  'boss/boss.c',
  'boss/strategy.c',
  'boss/entity.c',
  'boss/hit.c',
  'boss/defeat.c',
  'boss/b05.c',
  'boss/b10m.c',
  'boss/b10j.c',
  'boss/b15j.c',
  'boss/b15m.c',
  'boss/b20j.c',
  'boss/b20m.c',
  'route_select.c',
  'sprite.c',
  'shape.c',
  'particles.c',
  'wave.c',
  'interleave.c',
  'transition.c',
  'scale2x.c',
  'items.c',
  'bonus_transition.c',
  'bonus.c',
  'hud.c',
  'timer.c',
  'hud_hp.c',
  'extend.c',
  'hooks.c',
  'shots.c',
  'rng.c',
  'pellet_assets.c',
  'shootout_lasers.c',
  'pellets.c',
  'missiles.c',
  'line_bullets.c',
  'player.c',
  'bomb.c',
  'miss.c',
  'opening/opening.c',
  'opening/load.c',
  'opening/strings.c',
  'vsync_irq.c',
  'wait.c',
  'finite.c',
  'orb.c',
  'input.c',
  'settings.c',
  'session.c',
  'sound.c',
  'score_data.c',
  'score.c',
  'ending.c',
  'ending_result.c',
  'ending_load.c',
  'invincibility.c',
  'gameplay_assets.c',
  'gameplay/end.c',
  'gameplay/exit.c',
  'gameplay/gameplay.c',
  'gameplay/life.c',
  'gameplay/pause.c',
  'gameplay/stage.c',
  'video.c',
  'palette.c',
  'text.c',
  'tram.c',
  'ptn.c',
  'grc.c',
  'grf.c',
  'grz.c',
  'stage/data.c',
  'scene.c',
  'stage/objects.c',
  'stage/stage.c',
  'stage/obstacles.c',
  'stage/orb.c',
  implicit_include_directories: false,
  dependencies: [core_dep, stg_dep, pc98_dep],
)

th01_version = custom_target(
  'th01_version',
  output: 'version.h',
  command: [python3, files('../../tools/meson/version_header'), 'th01', '@OUTPUT@'],
  build_always_stale: true,
)

th01_main_lib = static_library(
  'th01_main',
  'main.c',
  th01_version,
  implicit_include_directories: false,
  dependencies: [core_dep, stg_dep, pc98_dep],
)

# The sprite sheets of upstream's src/reiiden/sprites, which the programs
# carry as built-in files.
th01_sprites = [
  'bonusbox.bmp', 'ileave_m.bmp', 'laser_s.bmp', 'leaf_l.bmp', 'leaf_r.bmp',
  'leaf_s.bmp', 'pellet.bmp', 'pellet_c.bmp', 'pillar.bmp', 'shape8x8.bmp',
]

th01_sources = [files('entry.c')]
if host_machine.system() == 'windows'
  th01_sources += import('windows').compile_resources(
    'th01.rc',
    args: ['--include-dir', meson.current_build_dir(),
           '--include-dir', meson.project_source_root() / 'tools/packaging/th01'],
    depends: th01_version,
    depend_files: files('../../tools/packaging/th01/icon.ico'),
  )
endif

games += {
  'th01': {
    'sources': th01_sources,
    'title': '東方靈異伝',
    'title_en': 'Touhou 01',
    'subtitle_en': 'Highly Responsive to Prayers',
    'aspect': '16 / 10',
    'controls': 'th01',
    'fonts': ['fonts/shnmk16.bdf', 'fonts/shnm8x16r.bdf'],
    'builtin_dir': meson.current_source_dir() / 'sprites',
    'builtins': th01_sprites,
    'link_with': [th01_main_lib, th01_lib],
  },
}
