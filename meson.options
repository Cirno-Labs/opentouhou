# Selects which backend_<platform>.c a module with platform-specific code
# compiles in. Only 'sdl' exists today.
option(
  'platform',
  type: 'combo',
  choices: ['sdl'],
  value: 'sdl',
  description: 'Platform backend for modules such as core/input',
)
option(
  'releases_url',
  type: 'string',
  value: 'https://opentouhou.invalid/releases.json',
  description: 'URL of the release index that othpatch updates the games and itself from',
)
