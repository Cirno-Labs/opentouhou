#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-only
"""Set the version of a program for its next release.

Writes the version into src/<program>/version.txt and turns the
Unreleased section of docs/<program>/CHANGELOG.md into the section of
that version, "## X.Y.Z (YYYY-MM-DD)" with today's date in UTC. The
bump commit is the commit that the release workflow publishes, and a
released section never changes after it, so the date is set here.
The release workflow then publishes every program whose version has no
release yet. --commit commits the change.

--with-games, for othpatch, also makes every game ship that othpatch:
it writes the version into src/<game>/othpatch.txt, adds "Changed the
packages to ship othpatch X.Y.Z." to the game's unreleased changes and
raises the game's patch version by one in the same way.
"""

import argparse
import datetime
import subprocess
import sys
import textwrap
from pathlib import Path

from shared.changelog import UNRELEASED, VERBS, changelog_path, heading
from shared.versioning import (
    REPO_DIR,
    VERSION,
    games,
    othpatch_pin_path,
    programs,
    read_version,
    version_path,
)


def git(*args: str) -> str:
    return subprocess.run(
        ["git", *args], cwd=REPO_DIR, check=True, capture_output=True, text=True
    ).stdout.strip()


def release_changelog(path: Path, version: str) -> None:
    """Turn the Unreleased section of a changelog into the section of
    version, dated today in UTC."""
    lines = path.read_text().splitlines()
    if f"## {UNRELEASED}" not in lines:
        sys.exit(f"{path.relative_to(REPO_DIR)} has no unreleased changes")
    today = datetime.datetime.now(datetime.UTC).date().isoformat()
    lines[lines.index(f"## {UNRELEASED}")] = heading(version, today)
    path.write_text("\n".join(lines) + "\n")


def bump(program: str, version: str) -> list[Path]:
    """Set the version of program and return the files it changed."""
    version_path(program).write_text(f"{version}\n")
    release_changelog(changelog_path(program), version)
    return [version_path(program), changelog_path(program)]


def add_change(path: Path, entry: str) -> None:
    """Add an entry to the Unreleased section of a changelog, after the
    entries of the same verb, and add the section when it is absent."""
    lines = path.read_text().splitlines()
    if f"## {UNRELEASED}" not in lines:
        first = next(
            (i for i, line in enumerate(lines) if line.startswith("## ")), len(lines)
        )
        lines[first:first] = [f"## {UNRELEASED}", "", entry, ""]
        path.write_text("\n".join(lines) + "\n")
        return
    start = lines.index(f"## {UNRELEASED}")
    end = next(
        (i for i in range(start + 1, len(lines)) if lines[i].startswith("## ")),
        len(lines),
    )
    rank = VERBS.index(entry[2:].split(" ", 1)[0])
    at = start + 2 if start + 1 < end and not lines[start + 1].strip() else start + 1
    for i in range(start + 1, end):
        if (
            lines[i].startswith("- ")
            and VERBS.index(lines[i][2:].split(" ", 1)[0]) > rank
        ):
            break
        if lines[i].strip():
            at = i + 1
    lines.insert(at, entry)
    path.write_text("\n".join(lines) + "\n")


def ship_othpatch(game: str, version: str) -> list[Path]:
    """Make a game ship othpatch version in a new patch release, and return
    the files it changed."""
    major, minor, patch = read_version(version_path(game)).split(".")
    othpatch_pin_path(game).write_text(f"{version}\n")
    add_change(
        changelog_path(game), f"- Changed the packages to ship othpatch {version}."
    )
    return [othpatch_pin_path(game), *bump(game, f"{major}.{minor}.{int(patch) + 1}")]


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("program", choices=programs())
    parser.add_argument("version", help="such as 1.2.0")
    parser.add_argument(
        "--with-games",
        action="store_true",
        help="for othpatch: make every game ship it in a new patch release",
    )
    parser.add_argument("--commit", action="store_true", help="commit the change")
    args = parser.parse_args()
    version = args.version.removeprefix("v")
    if not VERSION.fullmatch(version):
        sys.exit("The version must look like 1.2.0")
    if args.with_games and args.program != "othpatch":
        sys.exit("--with-games is for othpatch only")
    if args.commit and git("status", "--porcelain"):
        sys.exit("The working tree has uncommitted changes")

    changed = bump(args.program, version)
    released = [f"{args.program} {version}"]
    if args.with_games:
        for game in games():
            changed += ship_othpatch(game, version)
            released.append(f"{game} {read_version(version_path(game))}")
    for path in changed:
        print(f"Changed {path.relative_to(REPO_DIR)}")
    if args.commit:
        body = f"Set the versions for the release of {', '.join(released)}."
        message = f"{args.program}: release {version}\n\n{textwrap.fill(body, 72)}\n"
        git("commit", "-q", "-m", message, "--", *map(str, changed))
        print("Committed. Push it, then run the release workflow.")


if __name__ == "__main__":
    main()
