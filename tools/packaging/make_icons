#!/usr/bin/env python3
"""Render a game's SVG icon into the Windows .ico and the macOS .icns.

The icons are committed beside the SVG, so builds need no converter.
Run this again after changing the SVG. Needs rsvg-convert and Pillow.
"""

import argparse
import io
import subprocess
from pathlib import Path

from PIL import Image

PACKAGING_DIR = Path(__file__).resolve().parent
ICO_SIZES = [16, 24, 32, 48, 64, 128, 256]
ICNS_SIZES = [16, 32, 64, 128, 256, 512, 1024]


def render(svg: Path, size: int) -> Image.Image:
    png = subprocess.run(
        ["rsvg-convert", "-w", str(size), "-h", str(size), str(svg)],
        check=True,
        capture_output=True,
    ).stdout
    return Image.open(io.BytesIO(png)).convert("RGBA")


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("game", help="such as th06")
    game = parser.parse_args().game
    svg = PACKAGING_DIR / f"{game}.svg"
    largest = render(svg, max(ICNS_SIZES))
    images = {size: render(svg, size) for size in ICO_SIZES}
    images[ICO_SIZES[-1]].save(
        PACKAGING_DIR / f"{game}.ico",
        sizes=[(size, size) for size in ICO_SIZES],
        append_images=[images[size] for size in ICO_SIZES[:-1]],
    )
    largest.save(PACKAGING_DIR / f"{game}.icns")
    print(f"Wrote {game}.ico and {game}.icns")


if __name__ == "__main__":
    main()
