#!/usr/bin/env python3
"""Write a file as a C source: embed_binary OUTPUT NAME INPUT.

The source defines the array NAME with the file's bytes and NAME + "Size"
with its size.
"""

import sys
from pathlib import Path


def main() -> None:
    output = Path(sys.argv[1])
    name = sys.argv[2]
    data = Path(sys.argv[3]).read_bytes()
    rows = [
        ",".join(str(byte) for byte in data[i : i + 32])
        for i in range(0, len(data), 32)
    ]
    output.write_text(
        "#include <stddef.h>\n#include <stdint.h>\n\n"
        f"extern const uint8_t {name}[];\n"
        f"extern const size_t {name}Size;\n\n"
        f"const uint8_t {name}[] = {{\n" + ",\n".join(rows) + "\n};\n"
        f"const size_t {name}Size = sizeof({name});\n"
    )


if __name__ == "__main__":
    main()
