"""Print the version that a build of a program reports."""

import argparse

from shared.versioning import generate_version

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("program", help="such as th06 or othpatch")
print(generate_version(parser.parse_args().program))
