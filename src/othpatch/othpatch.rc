#include <winver.h>

#include "version.h"

1 ICON "icon.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION OTHPATCH_VERSION_RC
PRODUCTVERSION OTHPATCH_VERSION_RC
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "opentouhou"
            VALUE "FileDescription", "othpatch: translations and updates for opentouhou"
            VALUE "FileVersion", OTHPATCH_VERSION
            VALUE "InternalName", "othpatch"
            VALUE "LegalCopyright", "GNU General Public License, version 3 only"
            VALUE "OriginalFilename", "othpatch.exe"
            VALUE "ProductName", "othpatch"
            VALUE "ProductVersion", OTHPATCH_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
