# Build a game's retail backend (dev only, see docs/BUILDING.md).
[group('replay')]
build game:
    just -f {{justfile_directory()}}/justfile _docker_build win media
    just -f {{justfile_directory()}}/justfile _docker_run win media replay {{game}}

# Build the native backends of this platform's build (debug or release), as
# tools/harness finds them, and print the program of game.
[group('replay')]
_native game target:
    #!/usr/bin/env bash
    set -euo pipefail
    root={{quote(justfile_directory())}}
    case "$(uname -s)" in
        Darwin)
            "$root/tools/mac/build" build --target {{target}} >&2
            echo "$root/build/mac-$(uname -m)/{{target}}/{{game}}native" ;;
        MINGW* | MSYS* | CYGWIN*)
            just -f "$root/justfile" _build win media {{target}} >&2
            echo "$root/build/win/{{target}}/{{game}}native.exe" ;;
        *)
            just -f "$root/justfile" _build linux media {{target}} >&2
            echo "$root/build/linux/{{target}}/{{game}}native" ;;
    esac

# Capture a person's play of a game's original into the case file case: the
# retail backend runs it in a window on the current display, paced to the
# game's frame rate, and records the held buttons until the game quits.
[group('replay')]
[no-cd]
live game data case:
    just -f {{justfile_directory()}}/justfile replay::build {{game}}
    {{quote(justfile_directory())}}/tools/harness capture {{game}} {{quote(case)}} \
        --backend retail --data {{quote(data)}} --live --window

# Check a game's native backend on its data: capture its native.txt, then
# replay the case headless and twice with screenshots, and fail unless
# every state row and every screenshot pair matches.
[group('replay')]
[no-cd]
native game data:
    #!/usr/bin/env bash
    set -euo pipefail
    root={{quote(justfile_directory())}}
    program=$(just -f "$root/justfile" replay::_native {{game}} debug)
    dir=$(mktemp -d)
    trap 'rm -rf "$dir"' EXIT
    harness=("$root/tools/harness")
    data=(--data {{quote(data)}} --program "$program")
    "${harness[@]}" capture {{game}} "$dir/case.othtc" "${data[@]}" --script "$root/replay/{{game}}/native.txt"
    shots=(--shots 0,100,every:300)
    "${harness[@]}" replay "$dir/case.othtc" "${data[@]}" --out "$dir/headless" --headless
    "${harness[@]}" replay "$dir/case.othtc" "${data[@]}" --out "$dir/first" "${shots[@]}"
    "${harness[@]}" replay "$dir/case.othtc" "${data[@]}" --out "$dir/second" "${shots[@]}" --against "$dir/first"
    echo "{{game}} native: $(grep -x 'rows = .*' "$dir/headless/report.ini"), $(grep -x 'shots = .*' "$dir/second/report.ini") match"

# Check a game's native port against its original: capture the original
# on the retail backend with an input script and replay the case on the
# native backend headless. With shots, also replay the case on the
# original with those screenshots and compare the native ones with them.
# Keeps the case and every run in out when it is given. Fails unless every
# state row matches, since the two backends draw differently.
[group('replay')]
[no-cd]
retail game data script shots="" out="":
    #!/usr/bin/env bash
    set -euo pipefail
    root={{quote(justfile_directory())}}
    just -f "$root/justfile" replay::build {{game}}
    program=$(just -f "$root/justfile" replay::_native {{game}} debug)
    dir=$(mktemp -d)
    trap 'rm -rf "$dir"' EXIT
    harness=("$root/tools/harness")
    data=(--data {{quote(data)}})
    "${harness[@]}" capture {{game}} "$dir/case.othtc" "${data[@]}" --backend retail --script {{quote(script)}}
    native=(--headless)
    if [ -n {{quote(shots)}} ]; then
        "${harness[@]}" replay "$dir/case.othtc" "${data[@]}" --backend retail --out "$dir/retail" --shots {{quote(shots)}}
        native=(--shots {{quote(shots)}} --against "$dir/retail")
    fi
    status=0
    "${harness[@]}" replay "$dir/case.othtc" "${data[@]}" --program "$program" --out "$dir/native" "${native[@]}" || status=$?
    cat "$dir/native/report.ini"
    if [ -n {{quote(shots)}} ]; then cat "$dir/native/shots.tsv"; fi
    if [ -n {{quote(out)}} ]; then
        mkdir -p {{quote(out)}}
        cp -r "$dir/case.othtc" "$dir/native" {{quote(out)}}
        if [ -d "$dir/retail" ]; then cp -r "$dir/retail" {{quote(out)}}; fi
    fi
    [ "$status" -le 1 ] && ! grep -qx '\[difference\]' "$dir/native/report.ini"

# Capture one case per .rpy file of the directory replays into out: the
# retail backend stages each into the original's replay slot and plays it.
[group('replay')]
[no-cd]
rpy-cases game data replays out:
    #!/usr/bin/env bash
    set -euo pipefail
    root={{quote(justfile_directory())}}
    just -f "$root/justfile" replay::build {{game}}
    mkdir -p {{quote(out)}}
    shopt -s nullglob
    for rpy in {{quote(replays)}}/*.rpy; do
        name=$(basename "$rpy" .rpy)
        "$root/tools/stage_rpy" {{game}} "$rpy" {{quote(out)}}/"$name.othtc" \
            --backend retail --data {{quote(data)}} --headless > /dev/null
        echo "captured $name"
    done

# Replay every case file of the directory cases on the native backend
# headless, with a release build and one process per case, and fail unless
# every state row of every case matches.
[group('replay')]
[no-cd]
check game data cases jobs=num_cpus():
    #!/usr/bin/env bash
    set -euo pipefail
    root={{quote(justfile_directory())}}
    program=$(just -f "$root/justfile" replay::_native {{game}} release)
    shopt -s nullglob
    list=({{quote(cases)}}/*.othtc)
    out=$(mktemp -d)
    trap 'rm -rf "$out"' EXIT
    printf '%s\0' "${list[@]}" | xargs -0 -P {{jobs}} -I{} sh -c \
        'name=$(basename "$1" .othtc); "$2/tools/harness" replay "$1" --program "$5" --data "$3" --out "$4/$name" --headless > "$4/$name.log" 2>&1 || touch "$4/$name.fail"' \
        _ {} "$root" {{quote(data)}} "$out" "$program"
    failed=0
    for case in "${list[@]}"; do
        name=$(basename "$case" .othtc)
        if [ -e "$out/$name.fail" ]; then
            failed=$((failed + 1))
            echo "FAIL $name"
            cat "$out/$name.log" "$out/$name/report.ini" 2> /dev/null || true
        else
            echo "ok   $name $(grep -x 'rows = .*' "$out/$name/report.ini")"
        fi
    done
    echo "${#list[@]} cases, $failed failed"
    [ "${#list[@]}" -gt 0 ] && [ "$failed" -eq 0 ]

# Build the patched DOSBox-X of the dosbox backend into the local image
# opentouhou-dosbox-x (dev only, see replay/dosbox/Dockerfile).
[group('replay')]
dosbox-x:
    docker build -q -t opentouhou-dosbox-x {{quote(justfile_directory() / "replay/dosbox")}}

# Check every hook of the patched DOSBox-X: the test library of
# replay/dosbox/test drives a small DOS program headless, and keeps its
# screenshot in shot when it is given.
[group('replay')]
[no-cd]
dosbox-x-test shot="": dosbox-x
    #!/usr/bin/env bash
    set -euo pipefail
    dir=$(mktemp -d)
    trap 'rm -rf "$dir"' EXIT
    docker run --rm --user "$(id -u):$(id -g)" -e HOME=/work \
        -v {{quote(justfile_directory() / "replay/dosbox")}}:/src:ro -v "$dir:/work" \
        opentouhou-dosbox-x bash -c '
            set -euo pipefail
            mkdir -p /work/base /work/overlay
            nasm -f bin -o /work/base/HOOKTEST.COM /src/test/hooktest.asm
            echo secret > /work/base/SECRET.TXT
            gcc -std=c2x -O2 -Wall -Wextra -Wno-unused-parameter -shared -fPIC \
                -I/src -o /work/hooktest.so /src/test/hooktest.c
            { cat /src/dosbox-x.conf; printf "[autoexec]\nC:\nHOOKTEST.COM\nexit\n"; } > /work/test.conf
            status=0
            timeout 60 dosbox-x -conf /work/test.conf -harness /work/hooktest.so \
                -- /work/base /work/overlay /work/shot.ppm > /work/log.txt 2>&1 || status=$?
            grep "^hooktest:" /work/log.txt || cat /work/log.txt
            exit "$status"'
    if [ -n {{quote(shot)}} ]; then cp "$dir/shot.ppm" {{quote(shot)}}; fi

# Check the dosbox backend end to end with its test game: build the Linux
# programs, assemble FRAMES.COM, capture replay/dosbox/test/frames.txt,
# replay the case headless and twice with screenshots, and check the run's
# sums in case.ini, its work/ and the watchdog of a run that hangs.
[group('replay')]
[no-cd]
dosbox-test: dosbox-x
    #!/usr/bin/env bash
    set -euo pipefail
    root={{quote(justfile_directory())}}
    just -f "$root/justfile" _build linux media debug >&2
    dir=$(mktemp -d)
    trap 'rm -rf "$dir"' EXIT
    mkdir "$dir/data"
    docker run --rm --user "$(id -u):$(id -g)" \
        -v "$root/replay/dosbox/test:/src:ro" -v "$dir/data:/data" \
        opentouhou-dosbox-x nasm -f bin -o /data/FRAMES.COM /src/frames.asm
    echo save > "$dir/data/SAVE.DAT"
    harness=("$root/tools/harness")
    data=(--backend dosbox --data "$dir/data")
    "${harness[@]}" capture dostest "$dir/case.othtc" "${data[@]}" --script "$root/replay/dosbox/test/frames.txt"
    unzip -p "$dir/case.othtc" case.ini > "$dir/case.ini"
    for sum in 'staged = 83' 'presses = 2' 'polls = [1-9][0-9]*' 'gdc_waits = [1-9][0-9]*' 'delays = [1-9][0-9]*' 'calls = [1-9][0-9]*'; do
        grep -qx "$sum" "$dir/case.ini" || { echo "case.ini lacks $sum"; cat "$dir/case.ini"; exit 1; }
    done
    "${harness[@]}" replay "$dir/case.othtc" "${data[@]}" --out "$dir/headless" --headless
    shots=(--shots 0,50,every:40)
    "${harness[@]}" replay "$dir/case.othtc" "${data[@]}" --out "$dir/first" "${shots[@]}"
    "${harness[@]}" replay "$dir/case.othtc" "${data[@]}" --out "$dir/second" "${shots[@]}" --against "$dir/first"
    [ "$(ls "$dir/headless/work")" = OUT.TXT ] || { echo "work/ holds $(ls -A "$dir/headless/work")"; exit 1; }
    echo H > "$dir/hang.txt"
    status=0
    "${harness[@]}" capture dostest "$dir/hang.othtc" "${data[@]}" --script "$root/replay/dosbox/test/frames.txt" \
        --file "$dir/hang.txt=stage.txt" 2> "$dir/hang.log" || status=$?
    [ "$status" -eq 2 ] && grep -q 'no site ran' "$dir/hang.log" || { echo "the hang ended with $status"; cat "$dir/hang.log"; exit 1; }
    echo "dostest dosbox: $(grep -x 'rows = .*' "$dir/headless/report.ini"), $(grep -x 'shots = .*' "$dir/second/report.ini") match, the watchdog fires"
