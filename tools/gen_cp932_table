#!/usr/bin/env python3
"""Generate the CP932 conversion tables of core/base.

Usage: tools/gen_cp932_table [OUTPUT]

OUTPUT defaults to src/core/base/cp932_table.c. The tables come from
Python's cp932 codec, which follows Windows code page 932: JIS X 0208,
the NEC and IBM extensions, the user-defined area, ASCII and half-width
katakana.

Several byte sequences decode to the same character for about 400
characters. The encoder table holds the one that Windows encodes the
character to: the lowest sequence outside the NEC-selected IBM extensions
(lead bytes 0xED and 0xEE). Python's encoder differs from Windows for 373
of them, so it is not used.
"""

import sys
from pathlib import Path

REPO_DIR = Path(__file__).resolve().parent.parent
DEFAULT_OUTPUT = REPO_DIR / "src/core/base/cp932_table.c"

LEADS = list(range(0x81, 0xA0)) + list(range(0xE0, 0xFD))
TRAIL_FIRST = 0x40
TRAIL_LAST = 0xFC
VALUES_PER_LINE = 8
NEC_IBM_LEADS = (0xED, 0xEE)


def decode(data: bytes) -> int | None:
    try:
        text = data.decode("cp932")
    except UnicodeDecodeError:
        return None
    if len(text) != 1:
        return None
    return ord(text)


def format_values(values: list[str], indent: str) -> list[str]:
    return [
        indent + ", ".join(values[i : i + VALUES_PER_LINE]) + ","
        for i in range(0, len(values), VALUES_PER_LINE)
    ]


def generate() -> str:
    single = [0] * 256
    for byte in range(256):
        if byte in LEADS:
            continue
        code_point = decode(bytes([byte]))
        assert code_point is not None, f"byte {byte:#04x} does not decode"
        single[byte] = code_point

    double = []
    for lead in LEADS:
        row = []
        for trail in range(TRAIL_FIRST, TRAIL_LAST + 1):
            code_point = decode(bytes([lead, trail]))
            assert code_point is None or 0 < code_point <= 0xFFFF
            row.append(code_point or 0)
        double.append(row)

    forms: dict[int, list[int]] = {}
    for byte, code_point in enumerate(single):
        if code_point >= 0x80:
            forms.setdefault(code_point, []).append(byte)
    for lead, row in zip(LEADS, double):
        for trail, code_point in enumerate(row, start=TRAIL_FIRST):
            if code_point != 0:
                forms.setdefault(code_point, []).append((lead << 8) | trail)
    pairs = []
    for code_point, codes in sorted(forms.items()):
        preferred = [code for code in codes if code >> 8 not in NEC_IBM_LEADS]
        pairs.append((code_point, min(preferred or codes)))

    lines = [
        "// Generated by tools/gen_cp932_table from Python's cp932 codec. Do",
        "// not edit; run the tool again instead.",
        '#include "cp932_table.h"',
        "",
        "// clang-format off",
        "const uint16_t g_Cp932SingleByte[256] = {",
        *format_values([f"0x{cp:04X}" for cp in single], "    "),
        "};",
        "",
        "const uint16_t g_Cp932DoubleByte[CP932_LEAD_COUNT][CP932_TRAIL_COUNT]"
        " = {",
    ]
    for lead, row in zip(LEADS, double):
        lines.append(f"    // Lead byte 0x{lead:02X}")
        lines.append("    {")
        lines += format_values([f"0x{cp:04X}" for cp in row], "        ")
        lines.append("    },")
    lines += [
        "};",
        "",
        f"const CP932_PAIR g_Cp932Encode[{len(pairs)}] = {{",
        *format_values(
            [f"{{ 0x{cp:04X}, 0x{code:04X} }}" for cp, code in pairs], "    "
        ),
        "};",
        "",
        f"const int32_t g_Cp932EncodeCount = {len(pairs)};",
        "// clang-format on",
        "",
    ]
    return "\n".join(lines)


def main() -> None:
    output = Path(sys.argv[1]) if len(sys.argv) > 1 else DEFAULT_OUTPUT
    output.write_text(generate(), encoding="utf-8")


if __name__ == "__main__":
    main()
