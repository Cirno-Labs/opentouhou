#!/usr/bin/env python3
"""Print the programs whose version has no GitHub release yet.

Prints two lines for $GITHUB_OUTPUT: othpatch=<version>, empty when
othpatch-v<version> is released already, and games=<games>, the games
whose <game>-v<version> has no release, separated by spaces. A version
without a section in the program's changelog is not ready for its
release and is left out: tools/bump writes that section.
"""

import argparse
import sys
import urllib.error
import urllib.request

from shared.changelog import changelog_path, section
from shared.othpatch_release import request
from shared.versioning import games, read_version, version_path


def has_release(repository: str, tag: str) -> bool:
    url = f"https://api.github.com/repos/{repository}/releases/tags/{tag}"
    try:
        with urllib.request.urlopen(request(url, "application/vnd.github+json")):
            return True
    except urllib.error.HTTPError as error:
        if error.code == 404:
            return False
        raise


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repository", required=True, help="such as rr-/opentouhou")
    args = parser.parse_args()

    def unreleased(program: str) -> str | None:
        version = read_version(version_path(program))
        if section(changelog_path(program).read_text(), version) is None:
            sys.stderr.write(f"{program} {version} has no changelog section yet\n")
            return None
        if has_release(args.repository, f"{program}-v{version}"):
            return None
        return version

    othpatch = unreleased("othpatch")
    print(f"othpatch={othpatch or ''}")
    print(f"games={' '.join(game for game in games() if unreleased(game))}")


if __name__ == "__main__":
    main()
