#!/usr/bin/env python3
"""Write a C header with the version of a game or of othpatch, for the
executable and its Windows resources.

GAME_VERSION is the version string from tools/shared/versioning.py.
GAME_VERSION_RC holds its numbers for VERSIONINFO: major, minor, patch
and 0.
--prefix replaces GAME in both names, such as OTHPATCH_VERSION.
Each --repository NAME=OWNER/REPO adds NAME_REPOSITORY, a GitHub
repository that publishes releases.
The header is rewritten only when its text changes.
"""

import argparse
import re
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from shared.versioning import generate_version


def numbers(version: str) -> str:
    return version.partition("-")[0].replace(".", ",") + ",0"


def repository(value: str) -> tuple[str, str]:
    name, _, repo = value.partition("=")
    if not re.fullmatch(r"[A-Z0-9_]+", name) or not re.fullmatch(
        r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+", repo
    ):
        raise argparse.ArgumentTypeError(f"not NAME=owner/name: {value}")
    return name, repo


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("program")
    parser.add_argument("output", type=Path)
    parser.add_argument("--prefix", default="GAME")
    parser.add_argument("--repository", type=repository, action="append", default=[])
    args = parser.parse_args()
    version = generate_version(args.program)
    text = (
        "#pragma once\n\n"
        f'#define {args.prefix}_VERSION "{version}"\n'
        f"#define {args.prefix}_VERSION_RC {numbers(version)}\n"
    )
    for name, repo in args.repository:
        text += f'#define {name}_REPOSITORY "{repo}"\n'
    if not args.output.exists() or args.output.read_text() != text:
        args.output.write_text(text)


if __name__ == "__main__":
    main()
